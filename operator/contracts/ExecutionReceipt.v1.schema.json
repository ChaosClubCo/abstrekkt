{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abstrekkt.dev/contracts/ExecutionReceipt/v1",
  "title": "ExecutionReceipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","receiptId","taskId","executor","status","checks","startedAt","completedAt"],
  "properties": {
    "schema": {"const": "ExecutionReceipt/v1"},
    "receiptId": {"type":"string","minLength":1},
    "taskId": {"type":"string","minLength":1},
    "executor": {"type":"string","enum":["codex","open-design","gabriel","todoist","pathors","manual","other"]},
    "supervisor": {"type":["string","null"]},
    "candidateRevision": {"type":["string","null"]},
    "status": {"type":"string","enum":["passed","failed","blocked","cancelled"]},
    "checks": {
      "type":"array",
      "items": {
        "type":"object","additionalProperties":false,
        "required":["name","status"],
        "properties": {
          "name":{"type":"string","minLength":1},
          "status":{"type":"string","enum":["passed","failed","skipped","blocked"]},
          "evidenceRef":{"type":"string","minLength":1}
        }
      }
    },
    "proposalId": {"type":"string","minLength":1},
    "proposalPayloadHash": {"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "approvalRef": {"type":"string","minLength":1},
    "artifactManifestRef": {"type":"string","minLength":1},
    "idempotencyKey": {"type":"string","minLength":1},
    "startedAt": {"type":"string","format":"date-time"},
    "completedAt": {"type":"string","format":"date-time"}
  }
}
