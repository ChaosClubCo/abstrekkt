{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abstrekkt.dev/contracts/ActionProposal/v1",
  "title": "ActionProposal/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","proposalId","taskId","executor","action","resources","risk","simulationRequired","approvalRequired","payloadHash","createdAt"],
  "properties": {
    "schema": {"const": "ActionProposal/v1"},
    "proposalId": {"type":"string","minLength":1},
    "taskId": {"type":"string","minLength":1},
    "executor": {"type":"string","enum":["gabriel","todoist","codex","manual","other"]},
    "action": {"type":"string","minLength":1},
    "resources": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "risk": {"type":"string","enum":["low","medium","high","critical","external_side_effect"]},
    "simulationRequired": {"type":"boolean"},
    "approvalRequired": {"type":"boolean"},
    "payload": {},
    "payloadHash": {"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "idempotencyKey": {"type":"string","minLength":1},
    "expiresAt": {"type":"string","format":"date-time"},
    "createdAt": {"type":"string","format":"date-time"}
  },
  "allOf": [
    {"if":{"properties":{"risk":{"enum":["high","critical","external_side_effect"]}},"required":["risk"]},"then":{"properties":{"approvalRequired":{"const":true}}}}
  ]
}
