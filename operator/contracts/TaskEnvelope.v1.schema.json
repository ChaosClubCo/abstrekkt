{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abstrekkt.dev/contracts/TaskEnvelope/v1",
  "title": "TaskEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","taskId","objective","source","authority","risk","executionTarget","capabilities","approvalRequired","evidenceRequired","createdAt"],
  "properties": {
    "schema": {"const": "TaskEnvelope/v1"},
    "taskId": {"type":"string","minLength":1},
    "objective": {"type":"string","minLength":1,"maxLength":4000},
    "source": {
      "type":"object","additionalProperties":false,"required":["system","actor"],
      "properties": {
        "system":{"type":"string","enum":["pathors","todoist","chatgpt","github","manual","other"]},
        "actor":{"type":"string","minLength":1},
        "correlationId":{"type":"string","minLength":1}
      }
    },
    "authority": {"type":"string","enum":["read","prepare","approve","execute"]},
    "risk": {"type":"string","enum":["low","medium","high","critical"]},
    "executionTarget": {"type":"string","enum":["codex","open-design","gabriel","todoist","pathors","manual","none"]},
    "capabilities": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "approvalRequired": {"type":"boolean"},
    "evidenceRequired": {"type":"array","uniqueItems":true,"items":{"type":"string","enum":["tests","lint","typecheck","build","artifact","simulation","approval","runtime","receipt"]}},
    "idempotencyKey": {"type":"string","minLength":1},
    "deadline": {"type":"string","format":"date-time"},
    "createdAt": {"type":"string","format":"date-time"}
  },
  "allOf": [
    {"if":{"properties":{"authority":{"enum":["approve","execute"]}},"required":["authority"]},"then":{"properties":{"approvalRequired":{"const":true}}}}
  ]
}
