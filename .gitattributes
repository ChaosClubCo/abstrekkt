abstrekkt-full/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
abstrekkt-full/**/*.m4a filter=lfs diff=lfs merge=lfs -text
abstrekkt-full/**/*.mov filter=lfs diff=lfs merge=lfs -text
