{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AgentBehaviorResult/v1",
  "title": "AgentBehaviorResult/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "verdict", "reason_codes"],
  "properties": {
    "schema": { "const": "AgentBehaviorResult/v1" },
    "verdict": { "enum": ["PASS", "FAIL", "INVALID_RUN", "INCONCLUSIVE", "ERROR"] },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
