{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "LiveAgentBehaviorConformanceReceipt/v1",
  "title": "LiveAgentBehaviorConformanceReceipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository_sha",
    "asset_id",
    "asset_version",
    "projection_hash",
    "task_hash",
    "provider_adapter_versions",
    "provider_results",
    "allProvidersExecuted",
    "behaviorallyConformant",
    "receipt_id",
    "timestamp"
  ],
  "properties": {
    "schema": { "const": "LiveAgentBehaviorConformanceReceipt/v1" },
    "repository_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "asset_id": { "type": "string", "minLength": 1 },
    "asset_version": { "type": "string", "minLength": 1 },
    "projection_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "task_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provider_adapter_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "provider_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider_id", "model_id", "status", "verdict", "reason_codes"],
        "properties": {
          "provider_id": { "type": "string", "minLength": 1 },
          "model_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["EXECUTED", "UNAVAILABLE", "ERROR"] },
          "verdict": { "enum": ["PASS", "FAIL", "INVALID_RUN", "INCONCLUSIVE", "ERROR"] },
          "evidence": { "$ref": "BehaviorExecutionEvidence.v1.schema.json" },
          "evidence_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "EXECUTED" } } },
            "then": { "required": ["evidence", "evidence_sha256"] }
          }
        ]
      }
    },
    "allProvidersExecuted": { "type": "boolean" },
    "behaviorallyConformant": { "type": "boolean" },
    "receipt_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
