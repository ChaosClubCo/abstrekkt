{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BehaviorConformanceTask/v1",
  "title": "BehaviorConformanceTask/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository_sha",
    "asset_id",
    "asset_version",
    "projection_hash",
    "task_hash",
    "fixture"
  ],
  "properties": {
    "schema": { "const": "BehaviorConformanceTask/v1" },
    "repository_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "asset_id": { "type": "string", "minLength": 1 },
    "asset_version": { "type": "string", "minLength": 1 },
    "projection_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "task_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "expected_utf8", "required_actions"],
      "properties": {
        "target": { "const": "fixture.txt" },
        "expected_utf8": { "type": "string" },
        "required_actions": {
          "type": "array",
          "prefixItems": [
            { "const": "MUTATION" },
            { "const": "VERIFICATION" },
            { "const": "COMPLETION_CLAIM" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    }
  }
}
