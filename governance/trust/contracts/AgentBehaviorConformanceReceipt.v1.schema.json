{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AgentBehaviorConformanceReceipt/v1",
  "title": "AgentBehaviorConformanceReceipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository_sha",
    "asset_id",
    "asset_version",
    "projection_hash",
    "task_hash",
    "provider_id",
    "model_id",
    "adapter_version",
    "evidence_sha256",
    "result",
    "receipt_id",
    "timestamp"
  ],
  "properties": {
    "schema": { "const": "AgentBehaviorConformanceReceipt/v1" },
    "repository_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "asset_id": { "type": "string", "minLength": 1 },
    "asset_version": { "type": "string", "minLength": 1 },
    "projection_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "task_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provider_id": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "minLength": 1 },
    "evidence_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "result": { "$ref": "AgentBehaviorResult.v1.schema.json" },
    "receipt_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
