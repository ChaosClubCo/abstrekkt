{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BehaviorExecutionEvidence/v1",
  "title": "BehaviorExecutionEvidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository_sha",
    "asset_id",
    "asset_version",
    "projection_hash",
    "task_hash",
    "provider_id",
    "runner_slot",
    "model_id",
    "adapter_version",
    "status",
    "actions"
  ],
  "properties": {
    "schema": { "const": "BehaviorExecutionEvidence/v1" },
    "repository_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "asset_id": { "type": "string", "minLength": 1 },
    "asset_version": { "type": "string", "minLength": 1 },
    "projection_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "task_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provider_id": { "type": "string", "minLength": 1 },
    "runner_slot": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["EXECUTED", "UNAVAILABLE", "ERROR"] },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "order", "target", "success"],
        "properties": {
          "type": { "enum": ["MUTATION", "VERIFICATION", "COMPLETION_CLAIM", "FAILURE_REPORT"] },
          "order": { "type": "integer", "minimum": 1 },
          "target": { "type": "string", "minLength": 1 },
          "success": { "type": "boolean" },
          "observed_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "detail": { "type": "string" }
        }
      }
    },
    "provider_error_code": { "type": "string" }
  }
}
