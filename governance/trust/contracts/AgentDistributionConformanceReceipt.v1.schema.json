{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AgentDistributionConformanceReceipt/v1",
  "title": "AgentDistributionConformanceReceipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repository_sha", "registry_hash", "adapters", "conformant", "receipt_id"],
  "properties": {
    "schema": { "const": "AgentDistributionConformanceReceipt/v1" },
    "repository_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "registry_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider_id", "adapter_version", "projection_hash", "active_assets"],
        "properties": {
          "provider_id": { "type": "string", "minLength": 1 },
          "adapter_version": { "type": "string", "minLength": 1 },
          "projection_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "active_assets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["asset_id", "version", "canonical_path", "source_hash"],
              "properties": {
                "asset_id": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 },
                "canonical_path": { "type": "string", "minLength": 1 },
                "source_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    },
    "conformant": { "type": "boolean" },
    "receipt_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
