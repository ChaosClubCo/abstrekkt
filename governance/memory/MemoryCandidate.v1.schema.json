{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MemoryCandidate/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "schema_version", "subject", "knowledge_class", "source", "content", "created_at"],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "MemoryCandidate/v1"},
    "subject": {"type": "string", "minLength": 1, "maxLength": 300},
    "knowledge_class": {"enum": ["ArchitectureDecision", "SystemSummary", "ProjectContext", "ResearchFinding", "CustomerContext", "Postmortem", "VerifiedProcedure", "GovernancePolicy", "ReleaseEvidenceSummary"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "reference", "observed_at"],
      "properties": {
        "system": {"enum": ["NOTION", "GITHUB", "GITBOOK", "MEM", "OPERATOR", "OTHER"]},
        "reference": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "revision": {"type": ["string", "null"]}
      }
    },
    "content": {"type": "string", "minLength": 1, "maxLength": 100000},
    "sensitivity": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"], "default": "INTERNAL"},
    "supersedes": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
