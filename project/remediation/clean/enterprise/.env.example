# Enterprise Profile Builder — environment template
# COMMIT THIS FILE. Never commit `.env`.
#
# RULE: VITE_* is shipped to the browser. Secrets must NOT be VITE_-prefixed.

# ===== PUBLIC (browser-safe) =====
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=          # anon key — RLS-enforced, public by design
VITE_API_BASE_URL=/api           # base URL of your server proxy

# ===== SERVER-ONLY (Supabase Edge Function env; never prefixed) =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=       # bypasses RLS — server only
ANTHROPIC_API_KEY=               # sk-ant-… — server only, used by the proxy
ALLOWED_ORIGINS=https://app.yourdomain.com,http://localhost:5173
