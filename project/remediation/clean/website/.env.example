# ──────────────────────────────────────────────────────────────────────────
#  FlashFusion — environment template  (COMMIT THIS FILE; never commit `.env`)
# ──────────────────────────────────────────────────────────────────────────
#  GOLDEN RULE
#    NEXT_PUBLIC_*  and  VITE_*   ->  shipped to the browser  ->  PUBLIC ONLY
#    everything else                 ->  server-only          ->  SECRETS HERE
#  Never give a secret a NEXT_PUBLIC_ or VITE_ prefix.
# ──────────────────────────────────────────────────────────────────────────

# ===== PUBLIC (safe to expose in the bundle) =====
NEXT_PUBLIC_SITE_URL=https://flashfusion.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # anon key — RLS-enforced, public by design
NEXT_PUBLIC_GA_ID=                       # G-XXXXXXXXXX
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=      # pk_live_… publishable is public by design

# Vite app equivalents (also public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_GA_MEASUREMENT_ID=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=/api

# ===== SERVER-ONLY (NEVER prefixed; never sent to the browser) =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=               # bypasses RLS — server only
ANTHROPIC_API_KEY=                       # sk-ant-…   server only
OPENAI_API_KEY=                          # server only
GITHUB_TOKEN=                            # server only
STRIPE_SECRET_API_KEY=                   # sk_live_…  server only
STRIPE_WEBHOOK_SECRET=                   # whsec_…    server only

# After filling real values, set them in your host's encrypted env UI
# (Vercel / Netlify / Render / Supabase) — not in any committed file.
