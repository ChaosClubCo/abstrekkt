# ====================================
# FlashFusion Production Environment Variables
# ====================================
# Copy this file to .env.production and fill in your actual values
# NEVER commit the actual .env.production file to Git

# ====================================
# APPLICATION CONFIG
# ====================================
NODE_ENV=production
VITE_APP_NAME=FlashFusion
VITE_APP_VERSION=1.0.0

# Site URLs
NEXT_PUBLIC_SITE_URL=https://flashfusion.co
NEXT_PUBLIC_APP_URL=https://app.flashfusion.co
VITE_SITE_URL=https://flashfusion.co
VITE_APP_URL=https://app.flashfusion.co

# ====================================
# SUPABASE (REQUIRED)
# ====================================
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# For Next.js (Site App)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# For Vite (Web App)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ====================================
# AI SERVICES (OPTIONAL - Add as needed)
# ====================================

# OpenAI (GPT-4, GPT-3.5, DALL-E)
OPENAI_API_KEY=sk-...
VITE_OPENAI_API_KEY=sk-...

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
GEMINI_API_KEY=AIza...
VITE_GEMINI_API_KEY=AIza...

# xAI Grok
GROK_API_KEY=xai-...
VITE_GROK_API_KEY=xai-...

# OpenRouter (Multi-model)
OPENROUTER_API_KEY=sk-or-...
VITE_OPENROUTER_API_KEY=sk-or-...

# ====================================
# PAYMENTS (OPTIONAL)
# ====================================

# Stripe
STRIPE_SECRET_API_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ====================================
# ANALYTICS (OPTIONAL)
# ====================================

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
VITE_GA_ID=G-XXXXXXXXXX

# Vercel Analytics (auto-enabled)
NEXT_PUBLIC_VERCEL_ANALYTICS=true

# ====================================
# EXTERNAL INTEGRATIONS (OPTIONAL)
# ====================================

# GitHub OAuth
GITHUB_OAUTH_CLIENT_ID=Iv1...
GITHUB_OAUTH_CLIENT_SECRET=...
NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID=Iv1...
VITE_GITHUB_OAUTH_CLIENT_ID=Iv1...

# Notion
NOTION_API_KEY=secret_...
NOTION_DATABASE_ID=...

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=...
VITE_ELEVENLABS_API_KEY=...

# Printify (Print-on-Demand)
PRINTIFY_API_KEY=...
VITE_PRINTIFY_API_KEY=...

# ====================================
# EMAIL (OPTIONAL)
# ====================================

# SendGrid
SENDGRID_API_KEY=SG....

# Resend
RESEND_API_KEY=re_...

# ====================================
# MONITORING & ERROR TRACKING (OPTIONAL)
# ====================================

# Sentry
SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
VITE_SENTRY_DSN=https://...@sentry.io/...

# ====================================
# SECURITY
# ====================================

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Session Secret (generate a strong random string)
SESSION_SECRET=your-super-secret-session-key-change-this

# ====================================
# CORS & SECURITY
# ====================================
ALLOWED_ORIGINS=https://flashfusion.co,https://app.flashfusion.co
CORS_ENABLED=true

# ====================================
# DEPLOYMENT
# ====================================
VERCEL=1
VERCEL_ENV=production
DEPLOYMENT_PLATFORM=vercel

# ====================================
# FEATURE FLAGS
# ====================================
ENABLE_ANALYTICS=true
ENABLE_ERROR_TRACKING=true
ENABLE_PAYMENTS=true
ENABLE_AI_FEATURES=true
ENABLE_BETA_FEATURES=false
ENABLE_DEBUG_MODE=false

# ====================================
# PERFORMANCE
# ====================================
ENABLE_CACHING=true
CACHE_TTL=3600
MAX_REQUEST_SIZE=10mb

# ====================================
# NOTES
# ====================================
# 1. All keys starting with NEXT_PUBLIC_ or VITE_ are exposed to the browser
# 2. Never expose sensitive keys (SERVICE_ROLE_KEY, SECRET keys) to the browser
# 3. Use Vercel Environment Variables UI for production secrets
# 4. Keep this template updated when adding new integrations
# 5. Minimum required: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
