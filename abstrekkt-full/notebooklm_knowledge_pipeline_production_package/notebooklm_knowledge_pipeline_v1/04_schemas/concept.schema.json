{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Concept",
  "type": "object",
  "required": [
    "concept_id",
    "canonical_name",
    "definition",
    "concept_type",
    "source_refs",
    "confidence"
  ],
  "properties": {
    "concept_id": {
      "type": "string"
    },
    "canonical_name": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "definition": {
      "type": "string"
    },
    "concept_type": {
      "enum": [
        "agent",
        "skill",
        "tool",
        "workflow",
        "memory",
        "mcp_server",
        "security_control",
        "artifact",
        "human_gate",
        "data_store",
        "architecture_pattern",
        "risk",
        "metric"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "review_status": {
      "enum": [
        "draft",
        "reviewed",
        "canonical",
        "deprecated",
        "contradicted"
      ]
    }
  }
}
