{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Asset",
  "type": "object",
  "required": [
    "asset_id",
    "filename",
    "source_type",
    "lane",
    "status",
    "sha256",
    "created_at"
  ],
  "properties": {
    "asset_id": {
      "type": "string"
    },
    "filename": {
      "type": "string"
    },
    "source_type": {
      "enum": [
        "deck_pdf",
        "visual_png",
        "audio_m4a",
        "video_mp4",
        "ocr_text",
        "transcript",
        "summary",
        "graph"
      ]
    },
    "lane": {
      "enum": [
        "deck",
        "visual",
        "audio",
        "video",
        "derived"
      ]
    },
    "status": {
      "enum": [
        "raw",
        "deduped",
        "blocked_ocr",
        "blocked_transcript",
        "processable",
        "processed",
        "qa_passed",
        "qa_failed",
        "skipped_duplicate"
      ]
    },
    "sha256": {
      "type": "string"
    },
    "size_bytes": {
      "type": "integer"
    },
    "topic_cluster": {
      "type": "string"
    },
    "provenance_parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
