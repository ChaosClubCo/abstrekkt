{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provenance Record",
  "type": "object",
  "required": [
    "provenance_id",
    "asset_id",
    "claim",
    "location",
    "confidence",
    "review_status"
  ],
  "properties": {
    "provenance_id": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "properties": {
        "page": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timestamp_start": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp_end": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence_excerpt": {
      "type": "string"
    },
    "evidence_type": {
      "enum": [
        "ocr_text",
        "transcript",
        "visual_observation",
        "manual_review",
        "derived_inference"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "review_status": {
      "enum": [
        "needs_human_review",
        "approved",
        "rejected",
        "superseded"
      ]
    }
  }
}
