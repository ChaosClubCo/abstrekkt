{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Relationship",
  "type": "object",
  "required": [
    "relationship_id",
    "source_concept_id",
    "predicate",
    "target_concept_id",
    "source_refs",
    "confidence"
  ],
  "properties": {
    "relationship_id": {
      "type": "string"
    },
    "source_concept_id": {
      "type": "string"
    },
    "predicate": {
      "enum": [
        "uses",
        "executes",
        "produces",
        "stores",
        "retrieves",
        "requires",
        "guards",
        "approves",
        "routes_to",
        "depends_on",
        "contradicts",
        "supports",
        "implements",
        "observes",
        "measures"
      ]
    },
    "target_concept_id": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "notes": {
      "type": "string"
    }
  }
}
