{
  "$schema": "https://schemas.designtokens.org/0.1.0/design-tokens.json",
  "name": "FlashFusion Studio Design System",
  "version": "2.0.0",
  "colors": {
    "brand": {
      "primary": "#3b82f6",
      "secondary": "#64748b",
      "accent": "#10b981"
    },
    "feedback": {
      "success": "#10b981",
      "warning": "#f59e0b",
      "error": "#ef4444",
      "info": "#3b82f6"
    },
    "neutrals": {
      "light": {
        "bg": "#ffffff",
        "surface": "#f8fafc",
        "text": "#0f172a"
      },
      "dark": {
        "bg": "#0f172a",
        "surface": "#1e293b",
        "text": "#f8fafc"
      }
    }
  },
  "typography": {
    "fontFamily": "Inter, system-ui, sans-serif",
    "fontSize": {
      "h1": "2.5rem",
      "h2": "2rem",
      "h3": "1.5rem",
      "body": "1rem"
    }
  },
  "spacing": {
    "4": "1rem",
    "8": "2rem",
    "12": "3rem"
  }
}
