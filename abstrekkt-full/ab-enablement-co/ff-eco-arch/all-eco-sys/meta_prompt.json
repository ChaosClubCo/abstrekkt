{
  "mode": "app|ops",
  "input": {
    "concept": "string",
    "target_audience": "string",
    "performance_requirements": "string",
    "team_skills": "string",
    "budget": "string",
    "compliance": "string"
  },
  "output": {
    "deliverables": {
      "V": ["problem_definition", "persona_deck", "success_metrics"],
      "I": ["data_flow_diagram", "storage_strategy", "privacy_impact_assessment"],
      "S": ["stack_specification", "implementation_roadmap", "risk_assessment"],
      "T": ["test_plan", "automated_test_suite", "manual_test_protocols"],
      "A": ["ai_workflow_doc", "code_templates", "quality_standards"],
      "D": ["infrastructure_spec", "cicd_pipeline", "monitoring_security_config"],
      "E": ["feature_roadmap", "technical_debt_plan", "scaling_strategy"],
      "L": ["launch_plan", "marketing_materials", "support_docs"]
    },
    "templates": {
      "vision": "vision_worksheet",
      "integration": "data_flow_matrix",
      "stack": "stack_decision_tool",
      "testing": "test_suite_planner",
      "ai": "ai_prompt_log",
      "deployment": "deployment_tracker",
      "evolution": "evolution_planner",
      "launch": "launch_checklist"
    },
    "metrics": {
      "vision": {"problem_validation_rate": ">=80%"},
      "integration": {"data_flow_completeness": "100%"},
      "stack": {"decision_completion_time": "<=1 week"},
      "testing": {"test_coverage": ">85%"},
      "ai": {"productivity_boost": ">=20%"},
      "deployment": {"pipeline_lead_time": "<30 minutes"},
      "launch": {"conversion_rate": ">10%"},
      "evolution": {"monthly_retention": ">30%"}
    }
  },
  "constraints": [
    "follow security best practices (no hard‑coded secrets, role‑based access)",
    "implement scalable architecture on Vercel + Supabase",
    "include error handling, type hints and unit tests in generated code",
    "ensure compliance with specified regulations"
  ],
  "phases": ["V", "I", "S", "T", "A", "D", "E", "L"]
}
