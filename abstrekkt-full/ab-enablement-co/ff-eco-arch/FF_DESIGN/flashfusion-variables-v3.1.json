{
  "$schema": "https://jptr.be/figma-variables-schema/v1",
  "name": "FlashFusion v3.1",
  "description": "Canonical design tokens for all FlashFusion surfaces",
  "collections": [
    {
      "name": "Brand",
      "modes": ["Default"],
      "variables": [
        { "name": "violet",      "type": "COLOR", "values": { "Default": "#8B5CF6" } },
        { "name": "violet-hi",   "type": "COLOR", "values": { "Default": "#A855F7" } },
        { "name": "magenta",     "type": "COLOR", "values": { "Default": "#EC4899" } },
        { "name": "cyan",        "type": "COLOR", "values": { "Default": "#06B6D4" } },
        { "name": "cyan-hi",     "type": "COLOR", "values": { "Default": "#22D3EE" } }
      ]
    },
    {
      "name": "Surface",
      "modes": ["Dark"],
      "variables": [
        { "name": "void",        "type": "COLOR", "values": { "Dark": "#000000" } },
        { "name": "void-2",      "type": "COLOR", "values": { "Dark": "#05050A" } },
        { "name": "surface-1",   "type": "COLOR", "values": { "Dark": "#0B0B14" } },
        { "name": "surface-2",   "type": "COLOR", "values": { "Dark": "#13131F" } },
        { "name": "surface-3",   "type": "COLOR", "values": { "Dark": "#1A1A2E" } }
      ]
    },
    {
      "name": "Text",
      "modes": ["Dark"],
      "variables": [
        { "name": "text-1",      "type": "COLOR", "values": { "Dark": "#FFFFFF" } },
        { "name": "text-2",      "type": "COLOR", "values": { "Dark": "#C7C7D1" } },
        { "name": "text-3",      "type": "COLOR", "values": { "Dark": "#8A8A96" } },
        { "name": "text-4",      "type": "COLOR", "values": { "Dark": "#5A5A64" } }
      ]
    },
    {
      "name": "Border",
      "modes": ["Dark"],
      "variables": [
        { "name": "border",        "type": "COLOR", "values": { "Dark": { "r":0.545, "g":0.361, "b":0.965, "a":0.12 } } },
        { "name": "border-strong", "type": "COLOR", "values": { "Dark": { "r":0.545, "g":0.361, "b":0.965, "a":0.35 } } },
        { "name": "border-glow",   "type": "COLOR", "values": { "Dark": { "r":0.659, "g":0.333, "b":0.969, "a":0.60 } } }
      ]
    },
    {
      "name": "Semantic",
      "modes": ["Default"],
      "variables": [
        { "name": "success",     "type": "COLOR", "values": { "Default": "#10B981" } },
        { "name": "warning",     "type": "COLOR", "values": { "Default": "#F59E0B" } },
        { "name": "error",       "type": "COLOR", "values": { "Default": "#EF4444" } },
        { "name": "info",        "type": "COLOR", "values": { "Default": "#3B82F6" } }
      ]
    },
    {
      "name": "Spacing",
      "modes": ["Default"],
      "variables": [
        { "name": "space-1",     "type": "FLOAT", "values": { "Default": 4 } },
        { "name": "space-2",     "type": "FLOAT", "values": { "Default": 8 } },
        { "name": "space-3",     "type": "FLOAT", "values": { "Default": 12 } },
        { "name": "space-4",     "type": "FLOAT", "values": { "Default": 16 } },
        { "name": "space-5",     "type": "FLOAT", "values": { "Default": 20 } },
        { "name": "space-6",     "type": "FLOAT", "values": { "Default": 24 } },
        { "name": "space-8",     "type": "FLOAT", "values": { "Default": 32 } },
        { "name": "space-10",    "type": "FLOAT", "values": { "Default": 40 } },
        { "name": "space-12",    "type": "FLOAT", "values": { "Default": 48 } },
        { "name": "space-16",    "type": "FLOAT", "values": { "Default": 64 } },
        { "name": "space-20",    "type": "FLOAT", "values": { "Default": 80 } },
        { "name": "space-24",    "type": "FLOAT", "values": { "Default": 96 } }
      ]
    },
    {
      "name": "Radius",
      "modes": ["Default"],
      "variables": [
        { "name": "radius-xs",   "type": "FLOAT", "values": { "Default": 4 } },
        { "name": "radius-sm",   "type": "FLOAT", "values": { "Default": 6 } },
        { "name": "radius-md",   "type": "FLOAT", "values": { "Default": 8 } },
        { "name": "radius-lg",   "type": "FLOAT", "values": { "Default": 12 } },
        { "name": "radius-xl",   "type": "FLOAT", "values": { "Default": 16 } },
        { "name": "radius-2xl",  "type": "FLOAT", "values": { "Default": 24 } },
        { "name": "radius-full", "type": "FLOAT", "values": { "Default": 9999 } }
      ]
    },
    {
      "name": "Typography",
      "modes": ["Default"],
      "variables": [
        { "name": "font-body",      "type": "STRING", "values": { "Default": "Geist" } },
        { "name": "font-mono",      "type": "STRING", "values": { "Default": "Geist Mono" } },
        { "name": "font-display",   "type": "STRING", "values": { "Default": "Instrument Serif" } },
        { "name": "font-logo",      "type": "STRING", "values": { "Default": "Poppins" } },
        { "name": "text-xs",        "type": "FLOAT",  "values": { "Default": 12 } },
        { "name": "text-sm",        "type": "FLOAT",  "values": { "Default": 14 } },
        { "name": "text-base",      "type": "FLOAT",  "values": { "Default": 16 } },
        { "name": "text-lg",        "type": "FLOAT",  "values": { "Default": 18 } },
        { "name": "text-xl",        "type": "FLOAT",  "values": { "Default": 20 } },
        { "name": "text-2xl",       "type": "FLOAT",  "values": { "Default": 24 } },
        { "name": "text-4xl",       "type": "FLOAT",  "values": { "Default": 36 } },
        { "name": "text-6xl",       "type": "FLOAT",  "values": { "Default": 48 } }
      ]
    }
  ],
  "styles": {
    "gradients": {
      "brand": {
        "type": "GRADIENT_LINEAR",
        "gradientStops": [
          { "position": 0.00, "color": "#A855F7" },
          { "position": 0.55, "color": "#EC4899" },
          { "position": 1.00, "color": "#22D3EE" }
        ],
        "gradientTransform": [
          [0.7071, 0.7071, 0],
          [-0.7071, 0.7071, 0]
        ]
      }
    },
    "text_styles": {
      "Display/Hero": { "fontFamily": "Instrument Serif", "fontSize": 80, "fontWeight": 400, "lineHeight": 1.2, "letterSpacing": -0.02 },
      "Display/XL":   { "fontFamily": "Geist", "fontSize": 48, "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": -0.02 },
      "Display/LG":   { "fontFamily": "Geist", "fontSize": 36, "fontWeight": 600, "lineHeight": 1.35 },
      "Body/LG":      { "fontFamily": "Geist", "fontSize": 18, "fontWeight": 400, "lineHeight": 1.65 },
      "Body/MD":      { "fontFamily": "Geist", "fontSize": 16, "fontWeight": 400, "lineHeight": 1.5 },
      "Body/SM":      { "fontFamily": "Geist", "fontSize": 14, "fontWeight": 400, "lineHeight": 1.5 },
      "Label/CAPS":   { "fontFamily": "Geist", "fontSize": 12, "fontWeight": 500, "lineHeight": 1.2, "letterSpacing": 0.1, "textTransform": "UPPER" },
      "Code/MD":      { "fontFamily": "Geist Mono", "fontSize": 14, "fontWeight": 400, "lineHeight": 1.6 }
    },
    "effect_styles": {
      "Glow/Violet":  { "type": "DROP_SHADOW", "color": { "r":0.659,"g":0.333,"b":0.969,"a":0.25 }, "x":0, "y":0, "blur":24, "spread":0 },
      "Glow/Magenta": { "type": "DROP_SHADOW", "color": { "r":0.925,"g":0.282,"b":0.600,"a":0.30 }, "x":0, "y":0, "blur":24, "spread":0 },
      "Glow/Cyan":    { "type": "DROP_SHADOW", "color": { "r":0.133,"g":0.827,"b":0.933,"a":0.20 }, "x":0, "y":0, "blur":24, "spread":0 },
      "Shadow/LG":    { "type": "DROP_SHADOW", "color": { "r":0,"g":0,"b":0,"a":0.6 }, "x":0, "y":8, "blur":32, "spread":0 }
    }
  },
  "_setup_instructions": {
    "step_1": "Open Figma → Resources → Plugins → search 'Variables Import'",
    "step_2": "Paste this JSON into the plugin import field",
    "step_3": "Map Collections to Figma Local Variable collections",
    "step_4": "Import gradient and text styles via the Styles panel manually using values above",
    "step_5": "Fonts: ensure Geist, Geist Mono, Instrument Serif, Poppins are loaded via Google Fonts in Figma preferences",
    "note": "Figma does not natively import .fig files via JSON. Use this as the source of truth for manual setup or with the 'Tokens Studio' plugin which accepts this format directly."
  }
}
