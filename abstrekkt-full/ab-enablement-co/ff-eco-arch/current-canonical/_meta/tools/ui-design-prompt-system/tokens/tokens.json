      "radius": {
        "card": { "$value": "12px", "$type": "dimension" },
        "input": { "$value": "10px", "$type": "dimension" }
      },
      "density": { "$value": "ops", "$type": "string", "$description": "information-dense but scannable; avoid giant hero blocks" }
