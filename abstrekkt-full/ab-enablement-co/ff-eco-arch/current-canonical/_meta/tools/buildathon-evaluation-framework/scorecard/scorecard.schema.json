{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://intinc.local/buildathon/scorecard.schema.json",
  "title": "Project Scorecard",
  "description": "Validates a single project scorecard. Composite and status must be consistent with rubric/rubric.json. Numbers can be left null while UNKNOWN, but penalties apply per the rubric before scoring.",
  "type": "object",
  "required": ["project", "status", "validationScore", "totalDays", "riskTotal", "fitPct", "gatesPassed", "composite"],
  "additionalProperties": false,
  "properties": {
    "project": { "type": "string", "minLength": 1 },
    "owner": { "type": "string" },
    "projectStatus": {
      "type": "string",
      "enum": ["Idea", "Spike", "MVP", "Alpha", "Beta", "Shipped"],
      "description": "lifecycle stage of the project (distinct from the verdict 'status')"
    },
    "problemStatement": { "type": "string" },
    "userDiscovery": {
      "type": "object",
      "description": "Y=1, M=0.5, N=0, UNKNOWN=0 (-0.5 penalty each)",
      "additionalProperties": false,
      "properties": {
        "personally_feel_pain": { "$ref": "#/$defs/ynm" },
        "real_users_told_me": { "$ref": "#/$defs/ynm" },
        "quantified_cost_exists": { "$ref": "#/$defs/ynm" },
        "solving_unlocks_bigger": { "$ref": "#/$defs/ynm" },
        "current_workaround_painful": { "$ref": "#/$defs/ynm" }
      }
    },
    "validationScore": { "type": "number", "minimum": 0, "maximum": 5 },
    "totalDays": { "type": "integer", "minimum": 0 },
    "riskTotal": { "type": "integer", "minimum": 0, "maximum": 200 },
    "fitPct": { "type": "number", "minimum": 0, "maximum": 100 },
    "gatesPassed": { "type": "integer", "minimum": 0, "maximum": 9 },
    "qualityGates": {
      "type": "object",
      "description": "true only when implemented AND verifiable",
      "additionalProperties": false,
      "properties": {
        "input_validation": { "type": "boolean" },
        "error_handling": { "type": "boolean" },
        "secrets_protected": { "type": "boolean" },
        "testing": { "type": "boolean" },
        "observability": { "type": "boolean" },
        "documentation": { "type": "boolean" },
        "linting": { "type": "boolean" },
        "ci": { "type": "boolean" },
        "accessibility": { "type": "boolean" }
      }
    },
    "breakdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "painPoints": { "type": "number", "minimum": 0, "maximum": 30 },
        "timelinePoints": { "type": "number", "enum": [0, 5, 12, 20] },
        "riskPoints": { "type": "number", "minimum": 0, "maximum": 20 },
        "platformPoints": { "type": "number", "minimum": 0, "maximum": 15 },
        "qualityPoints": { "type": "number", "minimum": 0, "maximum": 15 }
      }
    },
    "composite": { "type": "number", "minimum": 0, "maximum": 100 },
    "status": {
      "type": "string",
      "enum": ["SHIP FIRST", "SHIP", "CONSIDER", "NOT READY", "Spike"]
    },
    "confidence": { "type": "string", "enum": ["High", "Medium", "Low"] },
    "topRisks": { "type": "array", "items": { "type": "string" }, "maxItems": 3 },
    "nextActions": { "type": "array", "items": { "type": "string" }, "maxItems": 3 },
    "reweighted": {
      "type": "boolean",
      "description": "true if dimension weights were changed for this contest; document why"
    }
  },
  "$defs": {
    "ynm": {
      "type": "object",
      "required": ["answer"],
      "properties": {
        "answer": { "type": "string", "enum": ["Y", "N", "M", "UNKNOWN"] },
        "evidence": { "type": "string" }
      }
    }
  }
}
