{
  "name": "source-of-truth-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Single source of truth consolidating ~130 active projects across the Krosebrook / FlashFusionv1 / ChaosClubCo orgs.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "audit": "pnpm audit --audit-level=high",
    "consolidate:plan": "python3 scripts/consolidate.py --plan IMPORT_PLAN.csv --dry-run",
    "consolidate:run": "python3 scripts/consolidate.py --plan IMPORT_PLAN.csv --confirm",
    "repo:map": "python3 scripts/consolidate.py --map-only"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}
