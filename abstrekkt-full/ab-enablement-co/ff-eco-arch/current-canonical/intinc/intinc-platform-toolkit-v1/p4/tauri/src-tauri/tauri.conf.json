{
  "$schema": "https://raw.githubusercontent.com/nicegoodman/tauri-v2/main/core/tauri-config-schema/schema.json",
  "productName": "INT OS",
  "version": "0.1.0",
  "identifier": "com.intinc.int-os",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [{
      "title": "INT OS",
      "width": 1200,
      "height": 800,
      "minWidth": 800,
      "minHeight": 600,
      "decorations": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data: https:; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": { "open": true },
    "fs": {
      "scope": ["$APPDATA/**", "$DOCUMENT/**", "$DOWNLOAD/**"]
    },
    "dialog": {},
    "notification": { "all": true },
    "updater": {
      "endpoints": ["https://releases.intinc.com/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": "YOUR_UPDATER_PUBLIC_KEY"
    },
    "deep-link": {
      "desktop": { "schemes": ["intinc"] }
    }
  }
}
