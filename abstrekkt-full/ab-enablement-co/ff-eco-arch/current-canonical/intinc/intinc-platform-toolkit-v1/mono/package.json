{
  "name": "@intinc/platform-toolkit",
  "version": "1.0.0",
  "private": true,
  "description": "INT Inc PWA/Electron/Tauri platform toolkit — monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "audit:scan": "pnpm --filter @intinc/cli-audit run scan",
    "audit:batch": "pnpm --filter @intinc/cli-audit run batch",
    "scaffold": "pnpm --filter @intinc/cli-scaffold run scaffold",
    "scaffold:pwa": "pnpm --filter @intinc/cli-scaffold run scaffold -- --template pwa-react",
    "scaffold:electron": "pnpm --filter @intinc/cli-scaffold run scaffold -- --template electron-react",
    "scaffold:tauri": "pnpm --filter @intinc/cli-scaffold run scaffold -- --template tauri-react",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["prettier --write", "eslint --fix"],
    "*.{json,md}": ["prettier --write"]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
