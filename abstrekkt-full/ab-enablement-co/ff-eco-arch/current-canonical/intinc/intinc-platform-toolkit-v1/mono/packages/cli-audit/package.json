{
  "name": "@intinc/cli-audit",
  "version": "1.0.0",
  "description": "CLI tool to scan and score apps for PWA/Electron/Tauri conversion",
  "type": "module",
  "bin": { "intinc-audit": "./dist/index.js" },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "scan": "tsx src/index.ts scan",
    "batch": "tsx src/index.ts batch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@intinc/shared": "workspace:*",
    "@octokit/rest": "^21.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "ora": "^8.0.0",
    "table": "^6.8.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
