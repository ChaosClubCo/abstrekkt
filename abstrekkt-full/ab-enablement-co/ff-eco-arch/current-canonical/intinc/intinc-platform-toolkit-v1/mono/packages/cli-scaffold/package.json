{
  "name": "@intinc/cli-scaffold",
  "version": "1.0.0",
  "description": "Interactive CLI to scaffold PWA, Electron, and Tauri apps from production templates",
  "type": "module",
  "bin": {
    "intinc-scaffold": "./dist/index.js",
    "scaffold": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "scaffold": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@intinc/shared": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ejs": "^3.1.10",
    "glob": "^11.0.0",
    "inquirer": "^10.2.0",
    "ora": "^8.0.0",
    "validate-npm-package-name": "^6.0.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/validate-npm-package-name": "^4.0.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
