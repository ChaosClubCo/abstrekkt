{
  "name": "@intinc/app-audit-cli",
  "version": "1.0.0",
  "description": "CLI tool to scan and score vibecoded apps for PWA/Electron conversion readiness",
  "type": "module",
  "bin": {
    "app-audit": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "audit": "tsx src/index.ts scan",
    "audit:repo": "tsx src/index.ts scan --repo",
    "audit:dir": "tsx src/index.ts scan --dir",
    "export:json": "tsx src/index.ts export --format json",
    "export:csv": "tsx src/index.ts export --format csv",
    "report": "tsx src/index.ts report"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "ora": "^8.0.0",
    "table": "^6.8.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
