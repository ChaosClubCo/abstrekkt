{
  "name": "My Custom GPT",
  "description": "A helpful assistant for [specific use case]",
  "instructions": "# Role\nYou are a [role description] who helps users with [specific tasks].\n\n# Context\nUsers typically come to you when they need help with [common scenarios].\n\n# Guidelines\n1. Always [guideline 1]\n2. Never [guideline 2]\n3. When asked about [topic], [specific instruction]\n\n# Output Format\n- For [task type A]: [format description]\n- For [task type B]: [format description]\n\n# Examples\n\n## Example 1: [Scenario]\nUser: [example user input]\nAssistant: [example assistant response]\n\n## Example 2: [Scenario]\nUser: [example user input]\nAssistant: [example assistant response]\n\n# Constraints\n- [Constraint 1]\n- [Constraint 2]\n- [Constraint 3]",
  "conversation_starters": [
    "How do I [common task 1]?",
    "Can you help me [common task 2]?",
    "Explain [concept] in simple terms",
    "What's the best way to [goal]?"
  ],
  "knowledge": {
    "files": [
      {
        "name": "documentation.pdf",
        "purpose": "Primary reference for [domain]"
      },
      {
        "name": "examples.csv",
        "purpose": "Sample data for demonstrations"
      },
      {
        "name": "faq.md",
        "purpose": "Common questions and answers"
      }
    ],
    "max_files": 20,
    "max_size_mb": 512,
    "supported_formats": [
      ".pdf",
      ".txt",
      ".md",
      ".doc",
      ".docx",
      ".csv",
      ".json",
      ".xml"
    ]
  },
  "capabilities": {
    "web_browsing": {
      "enabled": true,
      "description": "Allow GPT to search the web for current information"
    },
    "dalle_image_generation": {
      "enabled": true,
      "description": "Allow GPT to generate images with DALL·E"
    },
    "code_interpreter": {
      "enabled": true,
      "description": "Allow GPT to run Python code, analyze data, create charts"
    },
    "4o_image_generation": {
      "enabled": false,
      "description": "Enable GPT-4o's faster image generation (alternative to DALL·E)"
    }
  },
  "actions": [
    {
      "name": "Get Weather",
      "description": "Fetch current weather for a location",
      "schema": {
        "openapi": "3.1.0",
        "info": {
          "title": "Weather API",
          "version": "1.0.0",
          "description": "Simple weather lookup API"
        },
        "servers": [
          {
            "url": "https://api.weather.example.com"
          }
        ],
        "paths": {
          "/current": {
            "get": {
              "operationId": "getCurrentWeather",
              "summary": "Get current weather",
              "description": "Returns current weather data for specified location",
              "parameters": [
                {
                  "name": "location",
                  "in": "query",
                  "required": true,
                  "schema": {
                    "type": "string"
                  },
                  "description": "City name or coordinates (lat,lon)"
                },
                {
                  "name": "units",
                  "in": "query",
                  "required": false,
                  "schema": {
                    "type": "string",
                    "enum": [
                      "metric",
                      "imperial"
                    ],
                    "default": "metric"
                  },
                  "description": "Temperature units"
                }
              ],
              "responses": {
                "200": {
                  "description": "Successful response",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "location": {
                            "type": "string"
                          },
                          "temperature": {
                            "type": "number"
                          },
                          "conditions": {
                            "type": "string"
                          },
                          "humidity": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "components": {
          "securitySchemes": {
            "ApiKeyAuth": {
              "type": "apiKey",
              "in": "header",
              "name": "X-API-Key"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      },
      "authentication": {
        "type": "api_key",
        "api_key_header": "X-API-Key",
        "instructions": "Enter your Weather API key from https://api.weather.example.com/keys"
      },
      "privacy_policy": "https://weather.example.com/privacy",
      "allowed_models": [
        "gpt-4o",
        "gpt-4.1"
      ]
    },
    {
      "name": "Database Query",
      "description": "Query internal database via API",
      "schema": {
        "openapi": "3.1.0",
        "info": {
          "title": "Internal DB API",
          "version": "1.0.0"
        },
        "servers": [
          {
            "url": "https://api.internal.example.com"
          }
        ],
        "paths": {
          "/query": {
            "post": {
              "operationId": "executeQuery",
              "summary": "Execute database query",
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "table": {
                          "type": "string",
                          "description": "Table name"
                        },
                        "filters": {
                          "type": "object",
                          "description": "Filter criteria"
                        },
                        "limit": {
                          "type": "integer",
                          "default": 100
                        }
                      },
                      "required": [
                        "table"
                      ]
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Query results",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "results": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          },
                          "count": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "components": {
          "securitySchemes": {
            "OAuth2": {
              "type": "oauth2",
              "flows": {
                "authorizationCode": {
                  "authorizationUrl": "https://auth.example.com/oauth/authorize",
                  "tokenUrl": "https://auth.example.com/oauth/token",
                  "scopes": {
                    "read:data": "Read database records",
                    "write:data": "Write database records"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2": [
              "read:data"
            ]
          }
        ]
      },
      "authentication": {
        "type": "oauth",
        "client_id": "YOUR_CLIENT_ID",
        "authorization_url": "https://auth.example.com/oauth/authorize",
        "token_url": "https://auth.example.com/oauth/token",
        "scope": "read:data write:data",
        "token_exchange_method": "default_post"
      },
      "privacy_policy": "https://example.com/privacy"
    }
  ],
  "profile_picture": {
    "type": "uploaded",
    "description": "Custom avatar for GPT (512x512 recommended)",
    "alternatives": [
      "dalle_generated",
      "emoji",
      "initials"
    ]
  },
  "settings": {
    "model": "gpt-4o",
    "model_options": [
      "gpt-4o",
      "o3",
      "o4-mini",
      "gpt-4.1",
      "gpt-4.1-mini"
    ],
    "model_notes": {
      "actions_support": "Only gpt-4o and gpt-4.1 support Actions (not o-series)",
      "o_series_use": "Use o3 or o4-mini for reasoning-heavy Custom GPTs without Actions",
      "long_context": "Use gpt-4.1 for very long knowledge files (1M context)"
    },
    "sharing": {
      "type": "private",
      "options": [
        "private",
        "link",
        "public"
      ],
      "public_notes": "Public GPTs can be published to GPT Store"
    },
    "category": "productivity",
    "categories": [
      "productivity",
      "education",
      "lifestyle",
      "writing",
      "research",
      "programming",
      "data_analysis",
      "other"
    ]
  },
  "gpt_store": {
    "eligible": false,
    "requirements": [
      "Profile verified",
      "Builder profile complete",
      "Useful to others (reviewed)",
      "Compliant with usage policies",
      "Compliant with GPT brand guidelines"
    ],
    "monetization": "Coming soon (revenue sharing TBD)"
  },
  "testing": {
    "test_conversations": [
      {
        "scenario": "Basic query",
        "user_message": "How do I get started?",
        "expected_behavior": "Should provide step-by-step onboarding"
      },
      {
        "scenario": "Use Action",
        "user_message": "What's the weather in San Francisco?",
        "expected_behavior": "Should call Get Weather action successfully"
      },
      {
        "scenario": "Use knowledge",
        "user_message": "Find information about [specific topic from uploaded files]",
        "expected_behavior": "Should reference uploaded documentation"
      }
    ],
    "validation_checklist": [
      "Instructions are clear and specific",
      "Conversation starters work as expected",
      "Actions successfully authenticate",
      "Actions return expected data",
      "Knowledge files are referenced correctly",
      "Capabilities are enabled as needed",
      "No PII or sensitive data in instructions",
      "Complies with OpenAI usage policies"
    ]
  },
  "best_practices": {
    "instructions": [
      "Be specific about role and capabilities",
      "Include clear examples of desired behavior",
      "Define output formats explicitly",
      "Set boundaries on what GPT should/shouldn't do",
      "Use structured sections (## headings) for clarity",
      "Test edge cases and refine instructions"
    ],
    "knowledge": [
      "Upload only necessary files (cleaner context)",
      "Use descriptive file names",
      "Organize by topic if many files",
      "Keep files updated (re-upload when changed)",
      "Use PDF for formatted documents",
      "Use CSV/JSON for structured data"
    ],
    "actions": [
      "Start with simple GET requests",
      "Test authentication thoroughly",
      "Provide clear error messages in API",
      "Use descriptive operation IDs",
      "Document required vs optional parameters",
      "Handle rate limits gracefully",
      "Secure with API keys or OAuth (never 'none' for production)"
    ],
    "conversation_starters": [
      "Make them action-oriented",
      "Cover common use cases",
      "Keep them concise (3-8 words)",
      "Use questions or commands, not statements"
    ]
  },
  "limits": {
    "knowledge_files": 20,
    "knowledge_size_mb": 512,
    "actions": 10,
    "conversation_starters": 4,
    "instructions_chars": 8000,
    "name_chars": 40,
    "description_chars": 300
  },
  "notes": [
    "Custom GPTs are tied to your ChatGPT account",
    "Anyone with link can use link-shared GPTs",
    "Public GPTs require profile verification",
    "Actions only work with gpt-4o and gpt-4.1 models",
    "Knowledge files are not encrypted - don't upload sensitive data",
    "GPTs can be edited anytime after creation",
    "Consider creating evals/tests for complex GPTs"
  ],
  "resources": {
    "documentation": "https://platform.openai.com/docs/guides/gpts",
    "actions_guide": "https://platform.openai.com/docs/guides/gpts/actions",
    "openapi_spec": "https://spec.openapis.org/oas/v3.1.0",
    "community": "https://community.openai.com/c/gpts",
    "examples": "https://chatgpt.com/g/explore"
  }
}
