{
  "// Description": "Gemini CLI configuration",
  "// Location": ".gemini/config.json",
  
  "cli": {
    "model": "gemini-2.0-flash-exp",
    "temperature": 0.7,
    "maxTokens": 8192,
    "projectId": "your-gcp-project-id",
    "location": "us-central1"
  },
  
  "extensions": {
    "enabled": true,
    "autoUpdate": true,
    "marketplace": "https://geminicli.com/extensions",
    "sources": [
      {"type": "official", "registry": "google-ai"},
      {"type": "community", "registry": "npm"}
    ]
  },
  
  "playbooks": {
    "enabled": true,
    "directory": ".gemini/playbooks"
  },
  
  "security": {
    "apiKeys": {
      "storage": "env",
      "prefix": "GEMINI_"
    },
    "rateLimits": {
      "requestsPerMinute": 60,
      "tokensPerMinute": 50000
    }
  }
}
