{
  "version": "1.0",
  "updated": "2025-12-27",
  "description": "Default configuration for Gemini API integration",
  
  "models": {
    "default": "gemini-3-flash",
    "available": [
      "gemini-3-flash",
      "gemini-3-pro",
      "gemini-3-deep-think",
      "gemini-2.5-pro",
      "gemini-2.5-flash",
      "gemini-2.5-flash-lite"
    ],
    "specialized": [
      "veo-3",
      "imagen-4-standard",
      "gemini-2.5-flash-image"
    ]
  },
  
  "generation_config": {
    "temperature": 1.0,
    "top_p": 0.95,
    "top_k": 40,
    "max_output_tokens": 2048,
    "stop_sequences": []
  },
  
  "safety_settings": [
    {
      "category": "HARM_CATEGORY_HARASSMENT",
      "threshold": "BLOCK_MEDIUM_AND_ABOVE"
    },
    {
      "category": "HARM_CATEGORY_HATE_SPEECH",
      "threshold": "BLOCK_MEDIUM_AND_ABOVE"
    },
    {
      "category": "HARM_CATEGORY_SEXUALLY_EXPLICIT",
      "threshold": "BLOCK_MEDIUM_AND_ABOVE"
    },
    {
      "category": "HARM_CATEGORY_DANGEROUS_CONTENT",
      "threshold": "BLOCK_MEDIUM_AND_ABOVE"
    }
  ],
  
  "features": {
    "grounding": {
      "enabled": false,
      "sources": ["google_search", "google_maps"],
      "threshold": 0.7
    },
    "context_caching": {
      "enabled": false,
      "min_tokens": 32768,
      "ttl_hours": 24,
      "storage_cost_per_million_tokens_per_hour": 0.125
    },
    "function_calling": {
      "enabled": false,
      "mode": "AUTO",
      "allowed_function_names": []
    },
    "streaming": {
      "enabled": true,
      "chunk_size": 1024
    },
    "json_mode": {
      "enabled": false,
      "schema_validation": false
    }
  },
  
  "rate_limits": {
    "free_tier": {
      "requests_per_minute": 15,
      "tokens_per_minute": 1000000,
      "tokens_per_day": 50000000
    },
    "paid_tier": {
      "requests_per_minute": 2000,
      "tokens_per_minute": 4000000,
      "tokens_per_day": null
    }
  },
  
  "retry_policy": {
    "max_attempts": 3,
    "backoff_multiplier": 1.5,
    "max_backoff_seconds": 16,
    "retry_on_status_codes": [429, 500, 502, 503, 504]
  },
  
  "multimodal": {
    "image": {
      "max_size_mb": 20,
      "supported_formats": ["png", "jpeg", "webp", "gif", "bmp"],
      "token_count": 258
    },
    "audio": {
      "max_size_mb": 20,
      "supported_formats": ["mp3", "wav", "flac", "aac", "ogg"],
      "cost_per_minute": 0.05
    },
    "video": {
      "max_size_gb": 2,
      "max_duration_hours": 1,
      "supported_formats": ["mp4", "mov", "avi", "flv", "mpg", "webm", "wmv", "3gp"],
      "cost_per_second": 0.02
    },
    "pdf": {
      "max_size_mb": 20,
      "max_pages": 1000,
      "ocr_enabled": true
    }
  },
  
  "logging": {
    "level": "INFO",
    "format": "json",
    "include_request_id": true,
    "include_timestamp": true,
    "sanitize_sensitive_data": true
  },
  
  "monitoring": {
    "telemetry_enabled": false,
    "error_tracking_enabled": false,
    "performance_tracking_enabled": false
  },
  
  "endpoints": {
    "generativelanguage": {
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "models_endpoint": "/models",
      "generate_content": "/models/{model}:generateContent",
      "stream_generate_content": "/models/{model}:streamGenerateContent",
      "count_tokens": "/models/{model}:countTokens",
      "embed_content": "/models/{model}:embedContent"
    },
    "vertex_ai": {
      "base_url": "https://{region}-aiplatform.googleapis.com/v1",
      "predict_endpoint": "/projects/{project}/locations/{region}/publishers/google/models/{model}:predict",
      "stream_predict": "/projects/{project}/locations/{region}/publishers/google/models/{model}:streamPredict"
    }
  },
  
  "pricing": {
    "gemini-3-flash": {
      "input_per_million_tokens": 0.10,
      "output_per_million_tokens": 0.40,
      "cache_storage_per_million_tokens_per_hour": 0.125,
      "cache_input_discount": 0.60
    },
    "gemini-3-pro": {
      "input_per_million_tokens": 0.50,
      "output_per_million_tokens": 2.00,
      "cache_storage_per_million_tokens_per_hour": 0.125,
      "cache_input_discount": 0.60
    },
    "gemini-3-deep-think": {
      "input_per_million_tokens": 1.00,
      "output_per_million_tokens": 4.00,
      "cache_storage_per_million_tokens_per_hour": null,
      "cache_input_discount": null
    }
  }
}
