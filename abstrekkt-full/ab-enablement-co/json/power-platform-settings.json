{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Power Platform configuration template",
    "created": "2025-12-27",
    "version": "1.0.0"
  },
  "environment": {
    "name": "Production",
    "region": "United States",
    "type": "Production",
    "dataverse_enabled": true
  },
  "dataverse": {
    "language": "en-US",
    "currency": "USD",
    "security": {
      "row_level_security": true,
      "field_level_security": true
    },
    "storage": {
      "database_capacity_gb": 10,
      "file_capacity_gb": 20
    }
  },
  "dlp_policies": [
    {
      "name": "Production - Strict",
      "description": "Block personal connectors in production environment",
      "environments": ["Production"],
      "connector_groups": {
        "business": [
          "SharePoint",
          "Office 365 Outlook",
          "Dynamics 365",
          "SQL Server",
          "Dataverse",
          "Teams"
        ],
        "non_business": [
          "Gmail",
          "Twitter",
          "Dropbox",
          "Personal OneDrive"
        ],
        "blocked": []
      },
      "rules": [
        {
          "description": "Apps can only use Business connectors",
          "enforcement": "Apps cannot mix Business and Non-business connectors"
        }
      ],
      "enforcement": "immediate"
    }
  ],
  "power_apps": {
    "default_settings": {
      "theme": "corporate",
      "offline_mode": true,
      "analytics_enabled": true
    },
    "canvas_apps": {
      "authoring": {
        "formula_bar_enabled": true,
        "copilot_enabled": true
      }
    },
    "model_driven_apps": {
      "offline_sync_enabled": true,
      "mobile_app_enabled": true
    }
  },
  "power_automate": {
    "default_settings": {
      "run_mode": "cloud",
      "retry_policy": {
        "type": "exponential",
        "count": 3,
        "interval": "PT1M"
      }
    },
    "approval_settings": {
      "timeout_hours": 24,
      "reminder_hours": 12
    }
  },
  "power_pages": {
    "authentication": {
      "providers": [
        {
          "name": "Microsoft Entra ID",
          "enabled": true,
          "require_mfa": true
        },
        {
          "name": "Local accounts",
          "enabled": true,
          "password_policy": {
            "min_length": 12,
            "require_uppercase": true,
            "require_lowercase": true,
            "require_numbers": true,
            "require_symbols": true
          }
        }
      ]
    },
    "security": {
      "ip_filtering_enabled": false,
      "waf_enabled": true,
      "ddos_protection": true,
      "tls_version": "1.3"
    },
    "web_agent": {
      "enabled": true,
      "model": "gpt-4.1",
      "data_sources": [
        {
          "type": "dataverse",
          "table": "knowledge_articles"
        },
        {
          "type": "sharepoint",
          "site": "https://company.sharepoint.com/sites/support"
        }
      ],
      "channels": ["website", "email", "teams"],
      "escalation": {
        "enabled": true,
        "trigger_after_unresolved": 3,
        "target": "human_agent"
      }
    }
  },
  "power_bi": {
    "capacity": {
      "sku": "P1",
      "region": "United States"
    },
    "workspace_settings": {
      "default_data_classification": "Business",
      "allow_public_sharing": false
    },
    "data_refresh": {
      "schedule": "daily",
      "time": "02:00",
      "timezone": "Pacific Standard Time"
    }
  },
  "ai_builder": {
    "credits_per_month": 1000000,
    "models": [
      {
        "name": "Receipt Processing",
        "type": "prebuilt",
        "confidence_threshold": 0.8
      },
      {
        "name": "Sentiment Analysis",
        "type": "prebuilt",
        "languages": ["en", "es", "fr"]
      }
    ]
  },
  "connectors": {
    "premium_connectors_enabled": true,
    "custom_connectors_allowed": true,
    "rate_limiting": {
      "enabled": true,
      "max_requests_per_connection_per_minute": 600
    }
  },
  "governance": {
    "alm": {
      "source_control": "GitHub",
      "repository": "https://github.com/company/power-platform",
      "ci_cd_enabled": true,
      "pipeline": "Azure DevOps"
    },
    "environments": {
      "development": {
        "purpose": "Build and test",
        "dataverse": true,
        "dlp_policy": "Development - Permissive"
      },
      "test": {
        "purpose": "QA validation",
        "dataverse": true,
        "dlp_policy": "Test - Moderate"
      },
      "production": {
        "purpose": "Live for users",
        "dataverse": true,
        "dlp_policy": "Production - Strict"
      }
    }
  },
  "compliance": {
    "data_residency": "United States",
    "certifications": ["SOC 2", "ISO 27001", "GDPR"],
    "audit_log_retention_days": 90
  },
  "monitoring": {
    "enabled": true,
    "tools": ["Power Platform Admin Center", "Azure Monitor"],
    "alerts": [
      {
        "metric": "storage_usage",
        "threshold": 80,
        "action": "email",
        "recipients": ["admin@company.com"]
      },
      {
        "metric": "api_requests",
        "threshold": 1000000,
        "period": "daily",
        "action": "email"
      }
    ]
  }
}
