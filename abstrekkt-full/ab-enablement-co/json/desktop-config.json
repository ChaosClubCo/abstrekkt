{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/Users/username/Documents"],
      "description": "Read/write local files and directories",
      "capabilities": ["read_file", "write_file", "list_directory", "search_files"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      },
      "description": "Repository management, issues, PRs, code search",
      "capabilities": ["create_repo", "create_issue", "create_pr", "search_code"]
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://user:pass@localhost:5432/dbname"],
      "description": "PostgreSQL database queries and schema inspection",
      "capabilities": ["query", "schema_inspect"]
    },
    "slack": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx"
      },
      "description": "Slack message search, channel access, posting",
      "capabilities": ["search_messages", "post_message", "list_channels"]
    },
    "gdrive": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-gdrive"],
      "env": {
        "GDRIVE_CLIENT_ID": "your_client_id.apps.googleusercontent.com",
        "GDRIVE_CLIENT_SECRET": "your_client_secret"
      },
      "description": "Google Drive file search, document access, upload",
      "capabilities": ["search_files", "read_file", "upload_file"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "description": "Persistent key-value storage across sessions",
      "capabilities": ["get", "set", "delete", "list"]
    }
  },
  "globalShortcut": "CommandOrControl+Shift+Space",
  "theme": "auto",
  "fontSize": 14,
  "sendMessageShortcut": "Enter",
  "newLineShortcut": "Shift+Enter",
  "alwaysOnTop": false,
  "startMinimized": false,
  "closeToTray": true,
  "notifications": {
    "enabled": true,
    "sound": true
  },
  "privacy": {
    "analytics": true,
    "crashReports": true
  },
  "updates": {
    "autoCheck": true,
    "autoDownload": false
  }
}
