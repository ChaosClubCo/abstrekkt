{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Copilot Studio agent configuration template",
    "created": "2025-12-27",
    "version": "1.0.0"
  },
  "agent": {
    "name": "Sales Assistant",
    "description": "AI-powered sales agent for lead qualification and opportunity management",
    "model": {
      "provider": "Azure OpenAI",
      "name": "gpt-4.1",
      "fallback": "claude-ai",
      "temperature": 0.7,
      "max_tokens": 2000,
      "top_p": 0.9
    },
    "capabilities": {
      "autonomous_mode": true,
      "human_in_the_loop": true,
      "generative_actions": true,
      "mcp_integration": true
    },
    "topics": [
      {
        "name": "Lead Qualification",
        "trigger_phrases": [
          "qualify lead",
          "check lead score",
          "is this lead worth pursuing"
        ],
        "nodes": [
          {
            "type": "question",
            "text": "What's the company name?",
            "variable": "var_company"
          },
          {
            "type": "question",
            "text": "What's the company size?",
            "variable": "var_company_size",
            "entity": "number"
          },
          {
            "type": "action",
            "connector": "Dynamics 365 Sales",
            "action": "score_lead",
            "inputs": {
              "company": "{var_company}",
              "company_size": "{var_company_size}"
            },
            "outputs": {
              "score": "var_lead_score",
              "recommendation": "var_recommendation"
            }
          },
          {
            "type": "message",
            "text": "Lead score: {var_lead_score}/100. Recommendation: {var_recommendation}"
          }
        ]
      },
      {
        "name": "Create GitHub Issue",
        "trigger_phrases": [
          "create github issue",
          "file a bug",
          "open ticket in github"
        ],
        "nodes": [
          {
            "type": "question",
            "text": "What's the issue title?",
            "variable": "var_title"
          },
          {
            "type": "question",
            "text": "Describe the issue",
            "variable": "var_description"
          },
          {
            "type": "question",
            "text": "Which repository? (e.g., 'owner/repo')",
            "variable": "var_repo"
          },
          {
            "type": "action",
            "mcp_server": "GitHub MCP",
            "tool": "create_issue",
            "inputs": {
              "owner": "{split(var_repo, '/')[0]}",
              "repo": "{split(var_repo, '/')[1]}",
              "title": "{var_title}",
              "body": "{var_description}",
              "labels": ["bug", "from-copilot"]
            },
            "outputs": {
              "issue_url": "var_issue_url"
            }
          },
          {
            "type": "message",
            "text": "Issue created! View it here: {var_issue_url}"
          }
        ]
      }
    ],
    "mcp_servers": [
      {
        "name": "GitHub MCP",
        "url": "https://mcp.github.com/sse",
        "protocol": "sse",
        "authentication": {
          "type": "oauth2",
          "scopes": ["repo", "issues"]
        },
        "enabled": true
      },
      {
        "name": "Notion MCP",
        "url": "https://mcp.notion.com/mcp",
        "protocol": "http",
        "authentication": {
          "type": "api_key",
          "header": "Authorization"
        },
        "enabled": true
      },
      {
        "name": "Stripe MCP",
        "url": "https://mcp.stripe.com",
        "protocol": "http",
        "authentication": {
          "type": "bearer_token"
        },
        "enabled": false
      }
    ],
    "human_in_the_loop": {
      "enabled": true,
      "rules": [
        {
          "action_type": "financial",
          "condition": "amount > 500",
          "approvers": [
            {
              "role": "Finance Manager",
              "email": "finance-manager@company.com"
            }
          ],
          "fallback_approver": {
            "role": "VP Finance",
            "email": "vp-finance@company.com"
          },
          "timeout_hours": 24,
          "notification_channels": ["email", "teams"]
        },
        {
          "action_type": "data_deletion",
          "condition": "entity_type == 'customer'",
          "approvers": [
            {
              "role": "Data Steward",
              "email": "data-steward@company.com"
            }
          ],
          "timeout_hours": 48,
          "notification_channels": ["teams", "adaptive_card"]
        }
      ]
    },
    "security": {
      "authentication": {
        "provider": "Microsoft Entra ID",
        "require_mfa": true
      },
      "authorization": {
        "rbac_enabled": true,
        "rls_enabled": true
      },
      "encryption": {
        "at_rest": "AES-256",
        "in_transit": "TLS 1.3"
      },
      "audit": {
        "enabled": true,
        "retention_days": 90,
        "export_to": ["azure_log_analytics", "sentinel"]
      }
    },
    "performance": {
      "rate_limits": {
        "max_requests_per_minute": 100,
        "max_concurrent_sessions": 50
      },
      "timeout_seconds": 30,
      "retry": {
        "enabled": true,
        "max_attempts": 3,
        "backoff": "exponential"
      }
    },
    "monitoring": {
      "enabled": true,
      "metrics": [
        "prompt_count",
        "success_rate",
        "avg_response_time",
        "error_rate"
      ],
      "alerts": [
        {
          "metric": "error_rate",
          "threshold": 0.05,
          "duration_minutes": 5,
          "action": "email",
          "recipients": ["ops-team@company.com"]
        },
        {
          "metric": "avg_response_time",
          "threshold": 5000,
          "duration_minutes": 10,
          "action": "teams",
          "channel": "copilot-alerts"
        }
      ]
    }
  }
}
