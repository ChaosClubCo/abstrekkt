{
  "version": "1.0",
  "updated": "2025-12-27",
  "description": "Gemini for Workspace admin configuration template",
  
  "organization": {
    "name": "Example Company",
    "domain": "example.com",
    "workspace_plan": "business_plus",
    "total_users": 250
  },
  
  "gemini_settings": {
    "enabled_apps": [
      "gmail",
      "docs",
      "sheets",
      "slides",
      "drive",
      "meet",
      "chat"
    ],
    "disabled_apps": [],
    "rollout_strategy": "gradual",
    "pilot_users": [],
    "pilot_groups": []
  },
  
  "feature_controls": {
    "help_me_write": {
      "enabled": true,
      "allowed_for": ["all_users"]
    },
    "smart_reply": {
      "enabled": true,
      "allowed_for": ["all_users"]
    },
    "summarization": {
      "enabled": true,
      "allowed_for": ["all_users"]
    },
    "data_analysis": {
      "enabled": true,
      "allowed_for": ["all_users"]
    },
    "image_generation": {
      "enabled": false,
      "allowed_for": ["admins"]
    },
    "meeting_summaries": {
      "enabled": true,
      "allowed_for": ["business_plus_users"]
    },
    "workspace_search": {
      "enabled": true,
      "allowed_for": ["all_users"]
    }
  },
  
  "data_residency": {
    "region": "us",
    "available_regions": ["us", "eu", "global"],
    "enforce_strict_residency": false
  },
  
  "privacy_controls": {
    "use_for_training": false,
    "human_review": "never",
    "log_retention_days": 540,
    "allow_third_party_extensions": true,
    "require_data_processing_addendum": true
  },
  
  "extensions": {
    "enabled": true,
    "auto_approve_verified_publishers": false,
    "require_admin_approval": true,
    "max_extensions_per_user": 50,
    "allowed_extensions": [
      "salesforce",
      "hubspot",
      "jira",
      "linear",
      "notion",
      "slack",
      "zoom"
    ],
    "blocked_extensions": []
  },
  
  "usage_limits": {
    "max_requests_per_user_per_day": 1000,
    "max_tokens_per_request": 8192,
    "rate_limit_enabled": true,
    "quota_alerts": {
      "enabled": true,
      "threshold_percentage": 80,
      "alert_recipients": ["admin@example.com"]
    }
  },
  
  "content_policy": {
    "block_inappropriate_content": true,
    "content_filters": [
      "hate_speech",
      "violence",
      "sexual_content",
      "dangerous_information"
    ],
    "custom_blocklist": [],
    "require_citation_for_external_sources": true
  },
  
  "compliance": {
    "certifications_required": [
      "SOC2_TYPE2",
      "ISO27001",
      "GDPR"
    ],
    "hipaa_enabled": false,
    "ferpa_enabled": false,
    "data_loss_prevention": {
      "enabled": true,
      "scan_generated_content": true,
      "block_sensitive_data_sharing": true
    }
  },
  
  "audit_logging": {
    "enabled": true,
    "log_user_activity": true,
    "log_admin_actions": true,
    "log_extension_usage": true,
    "log_api_calls": false,
    "export_to_cloud_logging": true,
    "retention_days": 365
  },
  
  "reporting": {
    "usage_reports_enabled": true,
    "report_frequency": "weekly",
    "report_recipients": ["admin@example.com"],
    "metrics_to_track": [
      "active_users",
      "feature_adoption",
      "extension_usage",
      "cost_per_user",
      "content_policy_violations"
    ]
  },
  
  "cost_management": {
    "budget_alerts_enabled": true,
    "monthly_budget_usd": 5000,
    "alert_thresholds": [50, 75, 90],
    "auto_throttle_enabled": false,
    "cost_allocation_tags": {
      "department": "IT",
      "cost_center": "CC-1234"
    }
  },
  
  "notifications": {
    "admin_notifications": {
      "email": "admin@example.com",
      "slack_webhook": null,
      "notify_on": [
        "policy_violations",
        "quota_exceeded",
        "budget_alerts",
        "security_incidents"
      ]
    },
    "user_notifications": {
      "enabled": true,
      "notify_on_feature_updates": true,
      "notify_on_quota_warnings": true
    }
  },
  
  "integration_settings": {
    "allow_external_api_access": false,
    "webhook_endpoints": [],
    "oauth_applications": [],
    "service_accounts": []
  },
  
  "ai_studio_access": {
    "allow_users_to_create_api_keys": false,
    "allowed_user_groups": ["developers"],
    "require_justification": true,
    "auto_revoke_inactive_keys_days": 90
  },
  
  "workspace_migration": {
    "migrating_from": null,
    "migration_status": "not_started",
    "estimated_completion_date": null,
    "data_mapping": {}
  }
}
