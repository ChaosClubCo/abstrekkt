{
  "// Description": "VS Code settings for GitHub Copilot with MCP servers",
  "// Location": ".vscode/settings.json",
  
  "github.copilot.enable": {
    "*": true,
    "yaml": true,
    "markdown": true
  },
  
  "github.copilot.chat.enabled": true,
  "github.copilot.chat.participants": {
    "@workspace": true,
    "@vscode": true,
    "@terminal": true
  },
  
  "mcp.servers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${workspaceFolder}"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_TOKEN}"
      }
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://${env:DB_USER}:${env:DB_PASS}@localhost:5432/${env:DB_NAME}"
      ]
    }
  },
  
  "mcp.autoStart": true,
  "mcp.timeout": 30000
}
