{
  "name": "@abstrekkt/developer-command-os",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned registry, prompt compiler, policy engine, environment manifest, and evaluation suite for 200 AI developer commands.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dev-command-os": "./dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "cli": "tsx src/cli.ts",
    "docs": "tsx scripts/generate-docs.ts",
    "evals": "vitest run tests/evaluation.test.ts",
    "validate": "npm run typecheck && npm run test && npm run docs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
