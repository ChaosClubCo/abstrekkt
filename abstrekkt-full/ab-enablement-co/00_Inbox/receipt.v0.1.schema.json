{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outcome-aware-mcp.dev/schemas/receipt.v0.1.schema.json",
  "title": "Outcome Receipt",
  "description": "A structured claim about what changed in the world as a result of an MCP tool call. Extends OTel agent-run-record fields with a claim layer.",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "tool_call_id",
    "server_id",
    "tool_name",
    "timestamp_start",
    "timestamp_end",
    "intent",
    "claimed_changes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "description": "Schema version pinning"
    },
    "receipt_id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable identifier for this receipt"
    },
    "trace_id": {
      "type": "string",
      "description": "OTel trace ID for correlation"
    },
    "span_id": {
      "type": "string",
      "description": "OTel span ID for correlation"
    },
    "tool_call_id": {
      "type": "string",
      "description": "MCP tool call identifier"
    },
    "server_id": {
      "type": "string",
      "description": "MCP server identifier"
    },
    "tool_name": {
      "type": "string",
      "description": "Name of the MCP tool invoked"
    },
    "timestamp_start": {
      "type": "string",
      "format": "date-time",
      "description": "When the call started (ISO 8601)"
    },
    "timestamp_end": {
      "type": "string",
      "format": "date-time",
      "description": "When the call completed (ISO 8601)"
    },
    "caller_run_id": {
      "type": "string",
      "description": "Agent run identifier; correlates calls within a single agent execution"
    },
    "intent": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "description": "Free-text description of what the caller was trying to achieve"
        },
        "tag": {
          "type": "string",
          "enum": ["create", "read", "update", "delete", "notify", "compute", "compose"],
          "description": "Structured classification of intent"
        }
      }
    },
    "claimed_changes": {
      "type": "array",
      "description": "World-state changes the server asserts it made",
      "items": {
        "type": "object",
        "required": ["target", "change_type"],
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "string",
            "description": "URI or stable identifier of the changed entity"
          },
          "change_type": {
            "type": "string",
            "enum": ["create", "update", "delete", "append", "move", "annotate", "trigger", "none"],
            "description": "Kind of change. The 'none' value is the truthful response for idempotent re-calls where state was already correct."
          },
          "before_hash": {
            "type": "string",
            "description": "Hash or etag of target state before the change"
          },
          "after_hash": {
            "type": "string",
            "description": "Hash or etag of target state after the change"
          },
          "evidence_uri": {
            "type": "string",
            "format": "uri",
            "description": "URL where the change can be externally verified"
          },
          "side_effects": {
            "type": "array",
            "items": {"type": "string"},
            "description": "URIs of secondary effects (notifications fired, webhooks called, watchers triggered)"
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens_in": {"type": "integer", "minimum": 0},
        "tokens_out": {"type": "integer", "minimum": 0},
        "usd_cost": {"type": "number", "minimum": 0},
        "latency_ms": {"type": "integer", "minimum": 0}
      }
    },
    "verifiable": {
      "type": "boolean",
      "default": true,
      "description": "Can the claimed changes be independently re-fetched and verified?"
    },
    "verification_hints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["refetch", "diff", "idempotency", "negative", "side_effect", "time_decay", "phantom"]
      },
      "description": "Which probe types apply to this receipt"
    },
    "server_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Server-asserted confidence (0-1) that the change took effect"
    },
    "signature": {
      "type": "string",
      "description": "Optional HMAC signature over canonical receipt for non-repudiation"
    }
  }
}
