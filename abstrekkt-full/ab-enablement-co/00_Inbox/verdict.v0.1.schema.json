{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outcome-aware-mcp.dev/schemas/verdict.v0.1.schema.json",
  "title": "Outcome Verdict",
  "description": "Aggregated probe results assessing whether an Outcome Receipt's claims are true. Emitted by the Forgery Detector after probe execution.",
  "type": "object",
  "required": [
    "schema_version",
    "verdict_id",
    "receipt_id",
    "verdict",
    "probe_results",
    "produced_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "verdict_id": {
      "type": "string",
      "format": "uuid"
    },
    "receipt_id": {
      "type": "string",
      "format": "uuid",
      "description": "Foreign key to the Outcome Receipt being assessed"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "PARTIAL",
        "UNVERIFIABLE",
        "INCONSISTENT",
        "FORGED",
        "STALE",
        "OVERWRITTEN"
      ],
      "description": "Aggregate verdict state. Priority order on aggregation: FORGED > INCONSISTENT > STALE > OVERWRITTEN > VERIFIED > PARTIAL > UNVERIFIABLE."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Aggregate confidence; weighted geometric mean of probe confidences by cost class (low=1, medium=2, high=3)"
    },
    "probe_results": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["probe_name", "status"],
        "additionalProperties": false,
        "properties": {
          "probe_name": {
            "type": "string",
            "enum": ["refetch", "diff", "idempotency", "negative", "side_effect", "time_decay", "phantom"]
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "skipped", "error"]
          },
          "evidence": {
            "type": "object",
            "description": "Probe-specific evidence payload",
            "additionalProperties": true
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "cost_usd": {
            "type": "number",
            "minimum": 0
          },
          "latency_ms": {
            "type": "integer",
            "minimum": 0
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "total_probe_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "total_probe_latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
