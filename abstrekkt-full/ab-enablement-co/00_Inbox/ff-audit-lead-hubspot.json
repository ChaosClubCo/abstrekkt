{
  "name": "FF Audit Lead to HubSpot",
  "metadata": {
    "instant": true,
    "version": 1,
    "designer": { "orphans": [] },
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    }
  },
  "scheduling": { "type": "immediately" },
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": { "hook": 2448233, "maxResults": 1 },
      "mapper": {},
      "filter": null,
      "routes": [],
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "interface": [
          { "name": "firstname", "type": "text", "label": "First Name" },
          { "name": "lastname", "type": "text", "label": "Last Name" },
          { "name": "email", "type": "text", "label": "Email" },
          { "name": "company", "type": "text", "label": "Company" },
          { "name": "score", "type": "number", "label": "Audit Score (0-100)" },
          { "name": "tier", "type": "text", "label": "Score Tier (low/mid/high)" },
          { "name": "notes", "type": "text", "label": "Notes (optional)" }
        ],
        "parameters": [
          { "name": "hook", "type": "hook:gateway-webhook", "label": "Webhook", "required": true }
        ]
      }
    },
    {
      "id": 2,
      "module": "hubspot-crm:createContact",
      "version": 1,
      "parameters": { "__IMTCONN__": null },
      "mapper": {
        "email": "{{1.email}}",
        "firstname": "{{1.firstname}}",
        "lastname": "{{1.lastname}}",
        "company": "{{1.company}}",
        "lifecyclestage": "lead",
        "hs_lead_status": "NEW"
      },
      "filter": null,
      "routes": [],
      "metadata": {
        "designer": { "x": 300, "y": 0 },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:hubspot-crm3",
            "label": "HubSpot Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 3,
      "module": "hubspot-crm:createDeal",
      "version": 1,
      "parameters": { "__IMTCONN__": null },
      "mapper": {
        "dealname": "{{1.firstname}} {{1.lastname}} — Audit Lead ({{1.tier}})",
        "dealstage": "appointmentscheduled",
        "pipeline": "default",
        "amount": "4500",
        "associations": [{ "id": "{{2.id}}", "type": "contact" }]
      },
      "filter": null,
      "routes": [],
      "metadata": {
        "designer": { "x": 600, "y": 0 },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:hubspot-crm3",
            "label": "HubSpot Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 4,
      "module": "gmail:createADraft",
      "version": 1,
      "parameters": { "__IMTCONN__": null },
      "mapper": {
        "to": "kylerosebrook@gmail.com",
        "subject": "[FF Lead] {{1.firstname}} {{1.lastname}} — Score: {{1.score}} ({{1.tier}})",
        "body": "New audit lead from audit.flashfusion.co.\n\nName: {{1.firstname}} {{1.lastname}}\nEmail: {{1.email}}\nCompany: {{1.company}}\nScore: {{1.score}} / 100\nTier: {{1.tier}}\nNotes: {{1.notes}}\n\nHubSpot contact created. Deal created at Appointment Scheduled.\n\nReview and move pipeline stage when ready.",
        "contentType": "text"
      },
      "filter": null,
      "routes": [],
      "metadata": {
        "designer": { "x": 900, "y": 0 },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:google",
            "label": "Gmail Connection",
            "required": true
          }
        ]
      }
    }
  ],
  "interface": { "input": [], "output": [] }
}
