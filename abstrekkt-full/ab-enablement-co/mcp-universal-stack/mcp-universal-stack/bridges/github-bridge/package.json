{
  "name": "@mcp-stack/github-bridge",
  "version": "2.0.0",
  "description": "GitHub MCP Bridge - HTTP proxy for GitHub API operations",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
