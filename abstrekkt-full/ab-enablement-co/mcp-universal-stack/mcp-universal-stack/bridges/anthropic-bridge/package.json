{
  "name": "@mcp-universal/anthropic-bridge",
  "version": "2.0.0",
  "description": "MCP HTTP bridge for Anthropic Claude API - messages, vision, tool use",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
