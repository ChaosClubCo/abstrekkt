      "id": "6658e13b-535b-4e6a-bde0-28047534880f",
      "name": "Portfolio Sync Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1104,
        168
      ],
      "webhookId": "portfolio-sync"
