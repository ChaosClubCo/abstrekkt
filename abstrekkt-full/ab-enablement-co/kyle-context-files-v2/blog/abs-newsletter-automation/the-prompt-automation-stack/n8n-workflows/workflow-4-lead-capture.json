{
  "name": "The Prompt — Lead Capture Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "options": {
          "responseMode": "responseNode"
        }
      },
      "name": "Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "jsCode": "// Validate and normalize incoming lead data\n// Expected fields from Tally/Typeform/custom form:\n// name, email, company, need, budget_range, how_found\n\nconst body = $input.first().json.body || $input.first().json;\n\n// Basic validation\nconst name = (body.name || '').trim();\nconst email = (body.email || '').trim().toLowerCase();\nconst company = (body.company || '').trim();\nconst need = (body.need || body.message || body.description || '').trim();\nconst budget = (body.budget_range || body.budget || 'Not specified').trim();\nconst source = (body.how_found || body.source || 'Unknown').trim();\n\n// Email validation\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (!emailRegex.test(email)) {\n  return [{ json: { _invalid: true, reason: 'Invalid email', email } }];\n}\n\nif (!name) {\n  return [{ json: { _invalid: true, reason: 'No name provided' } }];\n}\n\nreturn [{\n  json: {\n    _invalid: false,\n    name,\n    email,\n    company: company || 'Not provided',\n    need: need || 'Not specified',\n    budget_range: budget,\n    source,\n    received_at: new Date().toISOString(),\n    status: 'new_lead'\n  }\n}];"
      },
      "name": "Validate Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "valid-check",
              "leftValue": "={{ $json._invalid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "notTrue"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Valid Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "create",
        "databaseId": {
          "__rl": true,
          "value": "YOUR_NOTION_LEAD_PIPELINE_ID",
          "mode": "id"
        },
        "title": "={{ $json.name }} — {{ $json.company }}",
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Email",
              "type": "emailType",
              "emailValue": "={{ $json.email }}"
            },
            {
              "key": "Company",
              "type": "richTextType",
              "textContent": "={{ $json.company }}"
            },
            {
              "key": "Need",
              "type": "richTextType",
              "textContent": "={{ $json.need }}"
            },
            {
              "key": "Budget Range",
              "type": "selectType",
              "selectValue": "={{ $json.budget_range }}"
            },
            {
              "key": "Source",
              "type": "selectType",
              "selectValue": "={{ $json.source }}"
            },
            {
              "key": "Stage",
              "type": "selectType",
              "selectValue": "New Lead"
            },
            {
              "key": "Received",
              "type": "dateType",
              "date": "={{ $json.received_at }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Create Notion Lead",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [690, 200]
    },
    {
      "parameters": {
        "subject": "=🎯 New Lead: {{ $json.name }} ({{ $json.company }})",
        "message": "=New consulting inquiry received.\n\nName: {{ $json.name }}\nEmail: {{ $json.email }}\nCompany: {{ $json.company }}\nNeed: {{ $json.need }}\nBudget: {{ $json.budget_range }}\nSource: {{ $json.source }}\nReceived: {{ $json.received_at }}\n\nRespond within 48 hours.",
        "toEmail": "YOUR_EMAIL_HERE"
      },
      "name": "Notify You",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [910, 200],
      "disabled": true
    },
    {
      "parameters": {
        "subject": "Thanks for reaching out — Kyle Rosebrook",
        "message": "=Hi {{ $json.name }},\n\nThanks for your interest in AI workflow consulting. I've received your inquiry and will get back to you within 48 hours.\n\nIn the meantime, you can check out my latest AI ecosystem insights at The Prompt: YOUR_SUBSTACK_URL\n\nBest,\nKyle",
        "toEmail": "={{ $json.email }}"
      },
      "name": "Auto-Reply",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [910, 400],
      "disabled": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, message: 'Thank you! I will be in touch within 48 hours.' }) }}"
      },
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1130, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, message: 'Please provide a valid name and email.' }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [690, 500]
    }
  ],
  "connections": {
    "Lead Webhook": {
      "main": [
        [{ "node": "Validate Lead", "type": "main", "index": 0 }]
      ]
    },
    "Validate Lead": {
      "main": [
        [{ "node": "Valid Lead?", "type": "main", "index": 0 }]
      ]
    },
    "Valid Lead?": {
      "main": [
        [{ "node": "Create Notion Lead", "type": "main", "index": 0 }],
        [{ "node": "Respond Error", "type": "main", "index": 0 }]
      ]
    },
    "Create Notion Lead": {
      "main": [
        [
          { "node": "Notify You", "type": "main", "index": 0 },
          { "node": "Auto-Reply", "type": "main", "index": 0 },
          { "node": "Respond OK", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "tags": [
    { "name": "the-prompt" },
    { "name": "leads" }
  ]
}
