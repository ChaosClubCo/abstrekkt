{
  "version": "0.1.0",
  "default_review": true,
  "agents": {
    "strategist": {
      "model_policy": "reasoning",
      "tools": [
        "knowledge_graph",
        "analytics"
      ],
      "requires_review": true,
      "output_schema": [
        "priority",
        "rationale",
        "tradeoffs",
        "next_actions"
      ]
    },
    "architect": {
      "model_policy": "reasoning",
      "tools": [
        "repo",
        "schemas"
      ],
      "requires_review": true,
      "output_schema": [
        "decision",
        "adr_needed",
        "migration",
        "risks"
      ]
    },
    "security": {
      "model_policy": "strict",
      "tools": [
        "schema",
        "logs"
      ],
      "requires_review": true,
      "output_schema": [
        "threat",
        "severity",
        "control",
        "test"
      ]
    },
    "product": {
      "model_policy": "balanced",
      "tools": [
        "prd",
        "analytics"
      ],
      "requires_review": false,
      "output_schema": [
        "requirement",
        "acceptance_criteria",
        "dependencies"
      ]
    },
    "delivery": {
      "model_policy": "balanced",
      "tools": [
        "templates",
        "client_context"
      ],
      "requires_review": true,
      "output_schema": [
        "artifact",
        "evidence",
        "gaps",
        "claim_status"
      ]
    },
    "revenue": {
      "model_policy": "balanced",
      "tools": [
        "crm",
        "pricing"
      ],
      "requires_review": true,
      "output_schema": [
        "lead_score",
        "offer",
        "draft",
        "follow_up"
      ]
    },
    "research": {
      "model_policy": "evidence",
      "tools": [
        "sources",
        "citations"
      ],
      "requires_review": true,
      "output_schema": [
        "extract",
        "source",
        "confidence",
        "gaps"
      ]
    },
    "prompt": {
      "model_policy": "balanced",
      "tools": [
        "prompt_library",
        "evals"
      ],
      "requires_review": false,
      "output_schema": [
        "prompt",
        "variables",
        "guardrails",
        "eval"
      ]
    }
  },
  "budget_policy": {
    "default_usd": 1.5,
    "approval_required_above_usd": 5.0
  }
}
