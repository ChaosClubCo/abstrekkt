{
  "name": "Weekly Review — Monday 8AM CT",
  "flow": [
    {
      "id": 1,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://api.notion.com/v1/databases/6c1e9ec5ad444fd3a9db7a3361c3aa6d/query",
        "method": "POST",
        "headers": [
          {"name": "Authorization", "value": "Bearer {{CONNECTION_KEY:notion}}"},
          {"name": "Notion-Version", "value": "2022-06-28"},
          {"name": "Content-Type", "value": "application/json"}
        ],
        "body": "{\"filter\":{\"property\":\"Status\",\"select\":{\"does_not_equal\":\"Done\"}},\"sorts\":[{\"property\":\"Priority\",\"direction\":\"descending\"},{\"property\":\"Due\",\"direction\":\"ascending\"}],\"page_size\":30}"
      },
      "metadata": {"designer": {"x": 0, "y": 0}, "label": "Get Open Tasks"}
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://api.resend.com/emails",
        "method": "POST",
        "headers": [
          {"name": "Authorization", "value": "Bearer {{CONNECTION_KEY:resend}}"},
          {"name": "Content-Type", "value": "application/json"}
        ],
        "body": "{\"from\":\"FlashFusion <kyle@flashfusion.co>\",\"to\":[\"kylerosebrook@gmail.com\"],\"subject\":\"📅 Weekly Review — Week of {{formatDate(now; \\\"MMM D\\\")}}\",\"text\":\"OPEN TASKS THIS WEEK:\\n{{join(map(1.data.results; \\\"properties.Name.title[].plain_text\\\"); \\\"\\n\\\")}}\\n\\nTotal open: {{length(1.data.results)}}\"}"
      },
      "metadata": {"designer": {"x": 300, "y": 0}, "label": "Send Weekly Review"}
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "zone": "us1.make.com",
    "notes": "Migrated from n8n kTWKqhC3QE0f1AhI. Schedule: Monday 8AM CT. Requires: Notion API key, Resend API key."
  }
}
