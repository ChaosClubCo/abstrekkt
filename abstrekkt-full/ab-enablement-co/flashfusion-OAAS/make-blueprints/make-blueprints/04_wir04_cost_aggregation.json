{
  "name": "WIR-04 — Weekly Cost Aggregation (Monday 7AM)",
  "flow": [
    {
      "id": 1,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://api.anthropic.com/v1/organizations/usage",
        "method": "GET",
        "headers": [
          {"name": "x-api-key", "value": "{{CONNECTION_KEY:anthropic}}"},
          {"name": "anthropic-version", "value": "2023-06-01"}
        ]
      },
      "metadata": {"designer": {"x": 0, "y": 0}, "label": "Fetch Anthropic Usage"}
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://us1.make.com/api/v2/users/me/billing",
        "method": "GET",
        "headers": [
          {"name": "Authorization", "value": "Token {{CONNECTION_KEY:make}}"}
        ]
      },
      "metadata": {"designer": {"x": 200, "y": 0}, "label": "Fetch Make Operations"}
    },
    {
      "id": 3,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://api.zapier.com/v1/usage",
        "method": "GET",
        "headers": [
          {"name": "X-API-Key", "value": "{{CONNECTION_KEY:zapier}}"}
        ]
      },
      "metadata": {"designer": {"x": 400, "y": 0}, "label": "Fetch Zapier Tasks"}
    },
    {
      "id": 4,
      "module": "tools:SetVariables2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          {"name": "anthropic_cost", "value": "{{1.data.total_cost}}"},
          {"name": "make_ops", "value": "{{2.data.used_operations}}"},
          {"name": "zapier_tasks", "value": "{{3.data.tasks_used}}"},
          {"name": "week_of", "value": "{{formatDate(now; \"YYYY-MM-DD\")}}"}
        ]
      },
      "metadata": {"designer": {"x": 600, "y": 0}, "label": "Aggregate Costs"}
    },
    {
      "id": 5,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://api.notion.com/v1/pages",
        "method": "POST",
        "headers": [
          {"name": "Authorization", "value": "Bearer {{CONNECTION_KEY:notion}}"},
          {"name": "Notion-Version", "value": "2022-06-28"},
          {"name": "Content-Type", "value": "application/json"}
        ],
        "body": "{\"parent\":{\"database_id\":\"CONFIGURE_COST_LOG_DB_ID\"},\"properties\":{\"Week\":{\"title\":[{\"text\":{\"content\":\"{{4.week_of}}\"}}]},\"Anthropic Cost\":{\"number\":{{4.anthropic_cost}}},\"Make Ops\":{\"number\":{{4.make_ops}}},\"Zapier Tasks\":{\"number\":{{4.zapier_tasks}}}}}"
      },
      "metadata": {"designer": {"x": 800, "y": 0}, "label": "Log to Notion"}
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "zone": "us1.make.com",
    "notes": "Migrated from n8n vTzMuNpichJO871n. REMOVED: Base44 LaneSummarySnapshot write (stale endpoint). REPLACED WITH: Notion log. CONFIGURE: CONFIGURE_COST_LOG_DB_ID. NOTE: Anthropic usage API endpoint may require org-level key. Schedule: Monday 7AM CT."
  }
}
