{
  "name": "FF Sales WF-03 — Heartbeat Executor (Every 15 Min)",
  "flow": [
    {
      "id": 1,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://api.base44.com/v1/apps/69d6866d29e0b32ab7e05bac/entities/OutreachSequence/query",
        "method": "POST",
        "headers": [
          {"name": "Authorization", "value": "Bearer {{CONNECTION_KEY:base44}}"},
          {"name": "Content-Type", "value": "application/json"}
        ],
        "body": "{\"filter\":{\"status\":{\"$eq\":\"active\"},\"next_send_at\":{\"$lte\":\"{{now}}\"}}}"
      },
      "metadata": {"designer": {"x": 0, "y": 0}, "label": "Query Due Sequences"}
    },
    {
      "id": 2,
      "module": "tools:BasicFeeder",
      "version": 1,
      "parameters": {"array": "{{1.data.results}}"},
      "mapper": {},
      "metadata": {"designer": {"x": 200, "y": 0}, "label": "Iterate Sequences"}
    },
    {
      "id": 3,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://api.base44.com/v1/apps/69d6866d29e0b32ab7e05bac/entities/Prospect/{{2.prospect_id}}",
        "method": "GET",
        "headers": [{"name": "Authorization", "value": "Bearer {{CONNECTION_KEY:base44}}"}]
      },
      "metadata": {"designer": {"x": 400, "y": 0}, "label": "GET Prospect"}
    },
    {
      "id": 4,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://api.base44.com/v1/apps/69d6866d29e0b32ab7e05bac/entities/EmailTemplate/query",
        "method": "POST",
        "headers": [
          {"name": "Authorization", "value": "Bearer {{CONNECTION_KEY:base44}}"},
          {"name": "Content-Type", "value": "application/json"}
        ],
        "body": "{\"filter\":{\"step\":{\"$eq\":\"{{2.current_step}}\"}}}"
      },
      "metadata": {"designer": {"x": 600, "y": 0}, "label": "Get Template"}
    },
    {
      "id": 5,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "headers": [
          {"name": "x-api-key", "value": "{{CONNECTION_KEY:anthropic}}"},
          {"name": "anthropic-version", "value": "2023-06-01"},
          {"name": "content-type", "value": "application/json"}
        ],
        "body": "{\"model\":\"claude-sonnet-4-20250514\",\"max_tokens\":500,\"messages\":[{\"role\":\"user\",\"content\":\"Personalize this email template for the prospect.\\n\\nTemplate: {{4.data.results[0].body}}\\nProspect Name: {{3.data.name}}\\nCompany: {{3.data.company}}\\nResearch: {{3.data.ai_research}}\\n\\nReturn only the personalized email body, no JSON wrapper.\"}]}"
      },
      "metadata": {"designer": {"x": 800, "y": 0}, "label": "Claude Personalize"}
    },
    {
      "id": 6,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://api.resend.com/emails",
        "method": "POST",
        "headers": [
          {"name": "Authorization", "value": "Bearer {{CONNECTION_KEY:resend}}"},
          {"name": "Content-Type", "value": "application/json"}
        ],
        "body": "{\"from\":\"Kyle Rosebrook <kyle@flashfusion.co>\",\"to\":[\"{{3.data.email}}\"],\"subject\":\"{{4.data.results[0].subject}}\",\"text\":\"{{5.data.content[0].text}}\"}"
      },
      "metadata": {"designer": {"x": 1000, "y": 0}, "label": "Send via Resend"}
    },
    {
      "id": 7,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://api.base44.com/v1/apps/69d6866d29e0b32ab7e05bac/entities/OutreachSequence/{{2.id}}",
        "method": "PATCH",
        "headers": [
          {"name": "Authorization", "value": "Bearer {{CONNECTION_KEY:base44}}"},
          {"name": "Content-Type", "value": "application/json"}
        ],
        "body": "{\"status\":\"sent\",\"sent_at\":\"{{now}}\",\"current_step\":{{add(2.current_step; 1)}}}"
      },
      "metadata": {"designer": {"x": 1200, "y": 0}, "label": "PATCH Sequence"}
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "zone": "us1.make.com",
    "notes": "Migrated from n8n fLXZmqph3vlVC0ro. IMPORTANT: This runs every 15 min — costs ~2,880 Make ops/month. Use Make Core plan minimum. Base44 app: Flagship Command (69d6866d). Requires: Base44 Bearer, Anthropic API key, Resend API key."
  }
}
