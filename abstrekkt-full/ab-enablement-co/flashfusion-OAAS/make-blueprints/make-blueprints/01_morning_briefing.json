{
  "name": "Morning Briefing — Daily 6AM CT",
  "flow": [
    {
      "id": 1,
      "module": "util:SetVariables2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          {"name": "notion_tasks_db", "value": "6c1e9ec5ad444fd3a9db7a3361c3aa6d"},
          {"name": "send_to", "value": "kylerosebrook@gmail.com"}
        ]
      },
      "metadata": {"designer": {"x": 0, "y": 0}, "restore": {}}
    },
    {
      "id": 2,
      "module": "google-calendar:listEvents",
      "version": 5,
      "parameters": {"__IMTCONN__": "{{CONNECTION:google-calendar}}"},
      "mapper": {
        "calendarId": "primary",
        "timeMin": "{{formatDate(now; \"YYYY-MM-DD\")}}T00:00:00Z",
        "timeMax": "{{formatDate(now; \"YYYY-MM-DD\")}}T23:59:59Z"
      },
      "metadata": {"designer": {"x": 200, "y": 0}}
    },
    {
      "id": 3,
      "module": "google-gmail:searchEmails",
      "version": 2,
      "parameters": {"__IMTCONN__": "{{CONNECTION:google-gmail}}"},
      "mapper": {
        "q": "is:unread after:{{formatDate(now; \"YYYY/MM/DD\")}}",
        "maxResults": 20,
        "fields": "messages(id,snippet)"
      },
      "metadata": {"designer": {"x": 400, "y": 0}}
    },
    {
      "id": 4,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://wttr.in/Mundelein+IL?format=j1",
        "method": "GET",
        "headers": [{"name": "User-Agent", "value": "FlashFusion-Briefing/1.0"}]
      },
      "metadata": {"designer": {"x": 600, "y": 0}}
    },
    {
      "id": 5,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://api.notion.com/v1/databases/{{1.notion_tasks_db}}/query",
        "method": "POST",
        "headers": [
          {"name": "Authorization", "value": "Bearer {{CONNECTION_KEY:notion}}"},
          {"name": "Notion-Version", "value": "2022-06-28"},
          {"name": "Content-Type", "value": "application/json"}
        ],
        "body": "{\"filter\":{\"and\":[{\"property\":\"Status\",\"select\":{\"does_not_equal\":\"Done\"}},{\"property\":\"Due\",\"date\":{\"on_or_before\":\"{{formatDate(now; \\\"YYYY-MM-DD\\\")}}\"}}]},\"sorts\":[{\"property\":\"Due\",\"direction\":\"ascending\"}]}"
      },
      "metadata": {"designer": {"x": 800, "y": 0}}
    },
    {
      "id": 6,
      "module": "tools:ComposeTransformer",
      "version": 1,
      "parameters": {},
      "mapper": {
        "value": "=== MORNING BRIEFING — {{formatDate(now; \"dddd MMMM D\")}} ===\n\nWEATHER (Mundelein IL):\n{{4.data.current_condition[].weatherDesc[].value}}, {{4.data.current_condition[].temp_F}}°F\n\nCALENDAR TODAY:\n{{join(map(2.; \"summary\"); \"\\n\")}}\n\nUNREAD EMAIL SUBJECTS:\n{{join(map(3.messages; \"snippet\"); \"\\n\")}}\n\nOPEN TASKS DUE:\n{{join(map(5.data.results; \"properties.Name.title[].plain_text\"); \"\\n\")}}\n\n---\nFlashFusion Command"
      },
      "metadata": {"designer": {"x": 1000, "y": 0}}
    },
    {
      "id": 7,
      "module": "google-gmail:sendEmail",
      "version": 2,
      "parameters": {"__IMTCONN__": "{{CONNECTION:google-gmail}}"},
      "mapper": {
        "to": "{{1.send_to}}",
        "subject": "☀️ Morning Briefing — {{formatDate(now; \"ddd MMM D\")}}",
        "content": "{{6.value}}",
        "contentType": "text/plain"
      },
      "metadata": {"designer": {"x": 1200, "y": 0}}
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {"orphans": []},
    "zone": "us1.make.com",
    "notes": "Migrated from n8n Ox31Oio70TITrzdJ. Runs daily 6AM CT. Set schedule in scenario settings. Requires: Google Calendar connection, Gmail connection, Notion API key (as HTTP header), Resend API key."
  }
}
