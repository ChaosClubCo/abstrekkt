{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlashFusion Telemetry Event",
  "type": "object",
  "required": [
    "event_id",
    "tenant_id",
    "event_type",
    "occurred_at"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "event_type": {
      "enum": [
        "asset.ingested",
        "asset.classified",
        "relationship.created",
        "relationship.unresolved",
        "agent.run.started",
        "agent.run.completed",
        "agent.mutation.proposed",
        "prompt.version.updated",
        "memory.marked_stale",
        "drift.detected"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "metadata": {
      "type": "object"
    }
  }
}
