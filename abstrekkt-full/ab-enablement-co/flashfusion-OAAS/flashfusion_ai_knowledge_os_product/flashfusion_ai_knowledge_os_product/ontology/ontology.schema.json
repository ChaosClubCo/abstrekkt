{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlashFusion Canonical Entity",
  "type": "object",
  "required": [
    "id",
    "tenant_id",
    "entity_type",
    "name",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "validated",
        "stale",
        "deprecated",
        "archived",
        "deleted",
        "quarantined",
        "unresolved"
      ]
    },
    "source_system": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "visibility_scope": {
      "enum": [
        "private",
        "team",
        "organization",
        "tenant",
        "public"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
