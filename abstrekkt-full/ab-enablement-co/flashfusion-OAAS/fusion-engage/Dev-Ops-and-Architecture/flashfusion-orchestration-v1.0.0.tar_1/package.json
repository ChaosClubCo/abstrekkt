{
  "name": "@flashfusion/orchestration",
  "version": "1.0.0",
  "description": "Production-grade AI orchestration library with 11-persona Symphony of Roles, RACI accountability, and MCP server integration",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js",
      "require": "./dist/mcp/server.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "tsup",
    "build:clean": "rm -rf dist && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "validate": "npm run type-check && npm run lint && npm run test",
    "security:secrets": "gitleaks detect --source . --verbose --no-git || true",
    "security:sbom": "cyclonedx-npm --output-file dist/sbom.json || echo 'SBOM generation skipped'",
    "security:licenses": "license-checker --production --onlyAllow 'MIT;Apache-2.0;BSD-3-Clause;ISC;0BSD' || true",
    "security:audit": "npm audit --production --audit-level=moderate || true",
    "security:full": "npm run security:secrets && npm run security:licenses && npm run security:audit",
    "prebuild": "npm run type-check",
    "prepublishOnly": "npm run validate && npm run build",
    "mcp:dev": "node --enable-source-maps dist/mcp/server.js",
    "mcp:start": "node dist/mcp/server.js",
    "docs:generate": "typedoc --out docs/api src/index.ts",
    "analyze:bundle": "source-map-explorer dist/*.js --html docs/bundle-analysis.html || true",
    "analyze:size": "size-limit || true"
  },
  "keywords": [
    "ai",
    "orchestration",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "raci",
    "personas",
    "flashfusion"
  ],
  "author": "FlashFusion <engineering@flashfusion.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flashfusion/orchestration.git"
  },
  "bugs": {
    "url": "https://github.com/flashfusion/orchestration/issues"
  },
  "homepage": "https://github.com/flashfusion/orchestration#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-security": "^3.0.0",
    "fast-check": "^3.22.0",
    "prettier": "^3.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typedoc": "^0.26.0",
    "vitest": "^2.1.0"
  },
  "optionalDependencies": {
    "gitleaks": "^8.0.0"
  },
  "peerDependencies": {
    "@cyclonedx/cyclonedx-npm": "^1.0.0",
    "license-checker": "^25.0.0"
  },
  "peerDependenciesMeta": {
    "@cyclonedx/cyclonedx-npm": {
      "optional": true
    },
    "license-checker": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "50 KB",
      "gzip": true
    },
    {
      "path": "dist/mcp/server.js",
      "limit": "55 KB",
      "gzip": true
    }
  ]
}
