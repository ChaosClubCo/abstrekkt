{
  "name": "@flashfusion/orchestration",
  "version": "1.0.0",
  "description": "Production-grade TypeScript orchestration library for AI agent coordination with enterprise security, observability, and compliance",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/mcp/server.ts",
    "build": "tsc --build && node scripts/post-build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:performance": "tsx tests/performance/benchmark.ts",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "security:scan": "npm audit && snyk test",
    "security:secrets": "gitleaks detect --source . --verbose",
    "security:sbom": "tsx scripts/generate-sbom.ts",
    "security:sign": "tsx scripts/sign-artifacts.ts",
    "perf:benchmark": "tsx tests/performance/benchmark.ts",
    "perf:load": "artillery run config/artillery.yml",
    "perf:profile": "node --inspect-brk --expose-gc dist/mcp/server.js",
    "docker:build": "docker build -f docker/Dockerfile -t flashfusion/orchestration:latest .",
    "docker:scan": "docker scan flashfusion/orchestration:latest",
    "docker:dev": "docker-compose -f docker/docker-compose.yml up",
    "docs:generate": "typedoc --out docs/api src/index.ts",
    "docs:serve": "npx serve docs/api",
    "prepare": "husky install",
    "prepublishOnly": "pnpm run build && pnpm run test && pnpm run security:scan",
    "mcp:start": "node dist/mcp/server.js",
    "mcp:inspect": "node --inspect dist/mcp/server.js"
  },
  "keywords": [
    "orchestration",
    "ai",
    "agents",
    "mcp",
    "coordination",
    "enterprise",
    "security",
    "observability"
  ],
  "author": "FlashFusion",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flashfusion/orchestration.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.txt"
  ],
  "dependencies": {
    "zod": "^3.22.4",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "@vitest/coverage-v8": "^1.3.1",
    "artillery": "^2.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-security": "^2.1.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "snyk": "^1.1275.0",
    "tsx": "^4.7.1",
    "typedoc": "^0.25.8",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run"
    ]
  },
  "pnpm": {
    "overrides": {
      "semver@<7.5.2": ">=7.5.2"
    }
  }
}
