{
  "name": "OAI WebhookBridge Pinger",
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "n1-png",
      "name": "Schedule Every 5 Min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        100,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "n2-png",
      "name": "Get Active Configs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Base44 API Key"
        }
      },
      "parameters": {
        "method": "GET",
        "url": "https://api.base44.com/apps/694c756124d640756ea9ba23/entities/ExecutionLayerConfig",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "is_active",
              "value": "true"
            },
            {
              "name": "_limit",
              "value": "50"
            }
          ]
        }
      }
    },
    {
      "id": "n3-png",
      "name": "Filter With Health URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const configs=($input.first().json.items||[]);const withUrl=configs.filter(c=>c.health_check_url);return withUrl.length?withUrl.map(c=>({json:{id:c._id||c.id,workspace_id:c.workspace_id,health_check_url:c.health_check_url}})):[{json:{skip:true}}];"
      }
    },
    {
      "id": "n4-png",
      "name": "Ping Health URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{$json.health_check_url}}",
        "authentication": "none",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 10000
        }
      }
    },
    {
      "id": "n5-png",
      "name": "Update Config Health Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Base44 API Key"
        }
      },
      "parameters": {
        "method": "PUT",
        "url": "=https://api.base44.com/apps/694c756124d640756ea9ba23/entities/ExecutionLayerConfig/{{$json.id}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"last_health_check_at\":\"{{$now.toISO()}}\",\"last_health_check_status\":\"healthy\"}"
      }
    }
  ],
  "connections": {
    "Schedule Every 5 Min": {
      "main": [
        [
          {
            "node": "Get Active Configs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Active Configs": {
      "main": [
        [
          {
            "node": "Filter With Health URL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter With Health URL": {
      "main": [
        [
          {
            "node": "Ping Health URL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ping Health URL": {
      "main": [
        [
          {
            "node": "Update Config Health Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}