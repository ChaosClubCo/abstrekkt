{
  "name": "OAI Data Retention Purge",
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "64feb898-bc13-404b-8a7b-cdc2dd84a70e",
      "name": "Schedule Nightly 2AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        100,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "1cd26d09-8557-4251-bbc3-4c01dac3cbc0",
      "name": "Get Retention Policies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Base44 API Key"
        }
      },
      "parameters": {
        "method": "GET",
        "url": "https://api.base44.com/apps/694c756124d640756ea9ba23/entities/DataRetentionPolicy",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "is_active",
              "value": "true"
            },
            {
              "name": "_limit",
              "value": "200"
            }
          ]
        }
      }
    },
    {
      "id": "efb2eeef-727a-449f-ac9c-c3e2ec84b1c9",
      "name": "Calculate Cutoffs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items=($input.first().json.items||[]);const now=new Date();const result=[];for(const p of items){if(!p.retention_days||p.retention_days===-1)continue;result.push({json:{policyId:p._id||p.id,entityType:p.entity_type,cutoffDate:new Date(now-p.retention_days*86400000).toISOString(),nextRunAt:new Date(now.getTime()+86400000).toISOString(),workspaceId:p.workspace_id}});}return result.length?result:[{json:{skip:true}}];"
      }
    },
    {
      "id": "8f098741-dfa2-4477-b320-a8f0bb994553",
      "name": "Update Policy Timestamps",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Base44 API Key"
        }
      },
      "parameters": {
        "method": "PUT",
        "url": "=https://api.base44.com/apps/694c756124d640756ea9ba23/entities/DataRetentionPolicy/{{$json.policyId}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"last_run_at\":\"{{$now.toISO()}}\",\"next_run_at\":\"{{$json.nextRunAt}}\",\"last_run_deleted_count\":0}"
      }
    }
  ],
  "connections": {
    "Schedule Nightly 2AM": {
      "main": [
        [
          {
            "node": "Get Retention Policies",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Retention Policies": {
      "main": [
        [
          {
            "node": "Calculate Cutoffs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Cutoffs": {
      "main": [
        [
          {
            "node": "Update Policy Timestamps",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}