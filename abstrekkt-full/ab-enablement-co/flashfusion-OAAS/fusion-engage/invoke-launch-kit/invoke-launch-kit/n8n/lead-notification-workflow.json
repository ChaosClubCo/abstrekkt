{
  "name": "Invoke — Lead Notifications",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "flashfusion-synthesis",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            {
              "leftValue": "={{ $json.event }}",
              "rightValue": "new_scorecard_lead",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "route-new-lead",
      "name": "New Scorecard Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.event }}",
              "rightValue": "scorecard_result_email",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "route-result-email",
      "name": "Result Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 500]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.event }}",
              "rightValue": "executive_report_send",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "route-exec-report",
      "name": "Executive Report?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 700]
    },
    {
      "parameters": {
        "sendTo": "kylerosebrook@gmail.com",
        "subject": "🎯 New Invoke Lead: {{ $json.lead_name }} — Score {{ $json.score }}/100",
        "message": "=<h2>New Scorecard Lead</h2><p><strong>{{ $json.lead_name }}</strong><br>{{ $json.lead_email }}<br>{{ $json.lead_company }}</p><hr><p><strong>Score:</strong> {{ $json.score }}/100<br><strong>Maturity:</strong> {{ $json.maturity_level }}<br><strong>Ecosystem:</strong> {{ $json.ecosystem }}</p><p><a href=\"{{ $json.admin_action_url }}\">View in Admin →</a></p>",
        "options": { "appendAttribution": false }
      },
      "id": "admin-email-new-lead",
      "name": "Admin Email — New Lead",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [700, 240]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.recipient_email }}",
        "subject": "Your AI Readiness Score: {{ $json.score }}/100 — {{ $json.maturity_level }}",
        "message": "=<h2>Your AI Readiness Score</h2><p>Hi {{ $json.recipient_name }},</p><p>Here are your results:</p><hr><p><strong>Score: {{ $json.score }}/100</strong><br><em>{{ $json.maturity_level }}</em></p><p>{{ $json.maturity_summary }}</p><h3>Your Top 3 Next Steps</h3><ol>{% for rec in $json.recommendations %}<li>{{ rec }}</li>{% endfor %}</ol><hr><p><a href=\"{{ $json.cta_url }}\">Book the Full Audit · $1,500 →</a></p><p>The full audit includes a 25-question deep dive, 90-day roadmap, and 1-hour strategy session.</p>",
        "options": { "appendAttribution": false }
      },
      "id": "lead-result-email",
      "name": "Lead Result Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [700, 500]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.recipient_email }}",
        "subject": "={{ $json.engagement_name }} — {{ $json.report_type === 'executive' ? 'Executive Briefing' : $json.report_type === 'team_lead' ? 'Milestone Report' : 'Team Update' }} · {{ $json.period }}",
        "message": "={{ $json.report_content }}",
        "options": { "appendAttribution": false }
      },
      "id": "exec-report-send",
      "name": "Send Role-Based Report",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [700, 700]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[
        { "node": "New Scorecard Lead?", "type": "main", "index": 0 },
        { "node": "Result Email?", "type": "main", "index": 0 },
        { "node": "Executive Report?", "type": "main", "index": 0 }
      ]]
    },
    "New Scorecard Lead?": {
      "main": [[{ "node": "Admin Email — New Lead", "type": "main", "index": 0 }]]
    },
    "Result Email?": {
      "main": [[{ "node": "Lead Result Email", "type": "main", "index": 0 }]]
    },
    "Executive Report?": {
      "main": [[{ "node": "Send Role-Based Report", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "_notes": [
    "Import this into n8n via: Workflows → Import from file",
    "Webhook path must match: flashfusion-synthesis",
    "Connect Gmail credential before activating",
    "Test each route separately using the webhook test URL"
  ]
}
