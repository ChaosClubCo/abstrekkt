{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flashfusion.local/schemas/onboarding-state.schema.json",
  "title": "OnboardingState",
  "description": "Per-user onboarding progress for the deal-sourcing/portfolio platform. Emitted by the Outcome-First wizard on each step.",
  "type": "object",
  "required": ["userId", "outcome", "currentStep", "activationReached", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "userId": { "type": "string", "description": "Stable user identifier (not PII)." },
    "outcome": {
      "type": "object",
      "description": "The north-star outcome captured first.",
      "required": ["choice"],
      "properties": {
        "choice": { "type": "string", "enum": ["find_deals", "track_portfolio", "join_community", "other"] },
        "freeText": { "type": "string", "maxLength": 500 }
      }
    },
    "dealCriteria": {
      "type": "object",
      "properties": {
        "assetClass": { "type": "array", "items": { "type": "string" } },
        "geography": { "type": "array", "items": { "type": "string" } },
        "ticketSizeUsd": { "type": "object", "properties": { "min": { "type": "number" }, "max": { "type": "number" } } },
        "riskBand": { "type": "string", "enum": ["conservative", "balanced", "aggressive"] }
      }
    },
    "portfolioGoals": {
      "type": "object",
      "properties": {
        "targetReturnPct": { "type": "number" },
        "horizonYears": { "type": "number" },
        "diversificationRules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "community": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["solo", "team", "syndicate"] },
        "visibility": { "type": "string", "enum": ["private", "team", "public"] }
      }
    },
    "compliance": {
      "type": "object",
      "description": "Gate that must be satisfied before portfolio/deal data unlocks.",
      "required": ["kycStatus"],
      "properties": {
        "kycStatus": { "type": "string", "enum": ["unstarted", "pending", "verified", "rejected"] },
        "accreditedInvestor": { "type": "boolean" }
      }
    },
    "currentStep": { "type": "integer", "minimum": 0, "maximum": 6 },
    "activationReached": {
      "type": "boolean",
      "description": "True only when the user completes their first-win task — NOT on form completion."
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
