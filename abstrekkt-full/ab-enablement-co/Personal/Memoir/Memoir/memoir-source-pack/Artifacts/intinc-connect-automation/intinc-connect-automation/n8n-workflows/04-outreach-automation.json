{
  "name": "INTINC Connect - Outreach Automation (Surveys, Nudges, Check-ins)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 9 * * 1" }]
        }
      },
      "id": "weekly-trigger",
      "name": "Weekly Monday 9AM Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.INTINC_CONNECT_API_URL}}/api/outreach/pending",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "fetch-pending-outreach",
      "name": "Fetch Pending Outreach",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [470, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "intinc-connect-api",
          "name": "INTINC Connect API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Categorize and prioritize outreach items\nconst response = $input.first().json;\nconst outreachItems = response.items || [];\n\nconst categorized = {\n  survey_reminders: [],\n  engagement_nudges: [],\n  wellness_checkins: [],\n  inactive_users: [],\n  recognition_prompts: []\n};\n\nfor (const item of outreachItems) {\n  switch (item.type) {\n    case 'survey_pending':\n      categorized.survey_reminders.push(item);\n      break;\n    case 'low_engagement':\n      categorized.engagement_nudges.push(item);\n      break;\n    case 'wellness_checkin':\n      categorized.wellness_checkins.push(item);\n      break;\n    case 'inactive':\n      categorized.inactive_users.push(item);\n      break;\n    case 'recognition_prompt':\n      categorized.recognition_prompts.push(item);\n      break;\n  }\n}\n\nreturn {\n  ...categorized,\n  total_count: outreachItems.length,\n  processed_at: new Date().toISOString()\n};"
      },
      "id": "categorize-outreach",
      "name": "Categorize Outreach",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.survey_reminders.length }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "has-survey-reminders",
      "name": "Has Survey Reminders?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [910, 100]
    },
    {
      "parameters": {
        "fieldToSplitOut": "survey_reminders",
        "options": {}
      },
      "id": "split-survey-reminders",
      "name": "Split Survey Reminders",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1130, 100]
    },
    {
      "parameters": {
        "fromEmail": "={{$env.INTINC_NOREPLY_EMAIL}}",
        "toEmail": "={{$json.email}}",
        "subject": "📋 Your feedback matters - {{$json.survey_name}}",
        "emailType": "html",
        "message": "=<html>\n<body style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <div style=\"background: #4F46E5; padding: 30px; text-align: center;\">\n    <h1 style=\"color: white;\">📋 We Value Your Voice!</h1>\n  </div>\n  \n  <div style=\"padding: 30px;\">\n    <p>Hi {{$json.first_name}},</p>\n    \n    <p>We noticed you haven't completed the <strong>{{$json.survey_name}}</strong> survey yet.</p>\n    \n    <p>Your feedback helps us build a better workplace for everyone at INTINC. It only takes about {{$json.estimated_time || '3 minutes'}}.</p>\n    \n    <div style=\"background: #EEF2FF; padding: 20px; border-radius: 8px; margin: 20px 0;\">\n      <p style=\"margin: 0;\"><strong>Quick stats:</strong></p>\n      <p style=\"margin: 5px 0;\">✅ {{$json.completion_rate}}% of your team has completed this survey</p>\n      <p style=\"margin: 5px 0;\">⏰ Survey closes: {{$json.deadline}}</p>\n    </div>\n    \n    <div style=\"text-align: center; margin: 30px 0;\">\n      <a href=\"{{$env.INTINC_CONNECT_URL}}/surveys/{{$json.survey_id}}\" style=\"background: #4F46E5; color: white; padding: 15px 30px; text-decoration: none; border-radius: 8px;\">Take Survey Now →</a>\n    </div>\n    \n    <p style=\"color: #6B7280; font-size: 14px;\">🔒 All responses are anonymous and require 5+ submissions before results are visible.</p>\n  </div>\n</body>\n</html>",
        "options": {}
      },
      "id": "send-survey-reminder",
      "name": "Send Survey Reminder",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1350, 100],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-intinc",
          "name": "INTINC Gmail"
        }
      }
    },
