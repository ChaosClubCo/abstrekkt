    {
      "parameters": {
        "jsCode": "// Generate personalized engagement nudge\nconst user = $input.first().json;\n\nconst nudgeTemplates = [\n  {\n    subject: `Hey ${user.first_name}, your team misses you! 👋`,\n    message: `It's been a while since we've seen you in INTINC Connect. Your teammates have been active - why not drop by and see what's happening?`,\n    cta: 'Check the Feed'\n  },\n  {\n    subject: `${user.first_name}, you have ${user.points_balance} points to give! 🎁`,\n    message: `Recognition goes a long way! You have ${user.points_balance} points available. Is there someone who helped you recently that deserves a shoutout?`,\n    cta: 'Give Recognition'\n  },\n  {\n    subject: `Quick win: Say thanks in 30 seconds ⚡`,\n    message: `Small acts of appreciation make big differences. Take 30 seconds to recognize someone who made your week better.`,\n    cta: 'Send Quick Thanks'\n  }\n];\n\nconst selectedTemplate = nudgeTemplates[Math.floor(Math.random() * nudgeTemplates.length)];\n\nreturn {\n  ...user,\n  nudge: selectedTemplate,\n  nudge_type: 'engagement',\n  generated_at: new Date().toISOString()\n};"
      },
      "id": "generate-engagement-nudge",
      "name": "Generate Engagement Nudge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1350, 250]
    },
    {
      "parameters": {
        "fromEmail": "={{$env.INTINC_NOREPLY_EMAIL}}",
        "toEmail": "={{$json.email}}",
        "subject": "={{$json.nudge.subject}}",
        "emailType": "html",
        "message": "=<html>\n<body style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <div style=\"padding: 30px;\">\n    <p>Hi {{$json.first_name}},</p>\n    \n    <p>{{$json.nudge.message}}</p>\n    \n    <div style=\"text-align: center; margin: 30px 0;\">\n      <a href=\"{{$env.INTINC_CONNECT_URL}}/feed\" style=\"background: #10B981; color: white; padding: 15px 30px; text-decoration: none; border-radius: 8px;\">{{$json.nudge.cta}} →</a>\n    </div>\n    \n    <p style=\"color: #6B7280; font-size: 14px;\">Remember: Recognition isn't just nice - it's proven to boost team morale and productivity! 📈</p>\n  </div>\n</body>\n</html>",
        "options": {}
      },
      "id": "send-engagement-nudge",
      "name": "Send Engagement Nudge",
