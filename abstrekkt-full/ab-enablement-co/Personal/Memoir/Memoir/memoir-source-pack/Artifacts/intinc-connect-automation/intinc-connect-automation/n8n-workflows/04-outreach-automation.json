        "jsonBody": "={\n  \"api_key\": \"{{$env.POSTHOG_API_KEY}}\",\n  \"event\": \"outreach_batch_completed\",\n  \"distinct_id\": \"system\",\n  \"properties\": {\n    \"total_outreach\": {{$node['Categorize Outreach'].json.total_count}},\n    \"survey_reminders_sent\": {{$node['Categorize Outreach'].json.survey_reminders.length}},\n    \"engagement_nudges_sent\": {{$node['Categorize Outreach'].json.engagement_nudges.length}},\n    \"wellness_checkins_sent\": {{$node['Categorize Outreach'].json.wellness_checkins.length}},\n    \"inactive_alerts_sent\": {{$node['Categorize Outreach'].json.inactive_users.length}},\n    \"workflow\": \"n8n_outreach_automation\",\n    \"processed_at\": \"{{$node['Categorize Outreach'].json.processed_at}}\"\n  }\n}",
        "options": {}
