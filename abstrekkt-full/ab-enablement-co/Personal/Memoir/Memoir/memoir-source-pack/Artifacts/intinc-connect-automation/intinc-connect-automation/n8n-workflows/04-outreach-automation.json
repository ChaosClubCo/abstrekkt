        "toEmail": "={{$json.email}}",
        "subject": "🌱 Weekly wellness check-in",
        "emailType": "html",
        "message": "=<html>\n<body style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <div style=\"background: linear-gradient(135deg, #10B981 0%, #059669 100%); padding: 30px; text-align: center;\">\n    <h1 style=\"color: white;\">🌱 Weekly Wellness Check-in</h1>\n  </div>\n  \n  <div style=\"padding: 30px;\">\n    <p>Hi {{$json.first_name}},</p>\n    \n    <p>Taking a moment to check in with yourself is an important part of maintaining work-life balance, especially when working remotely.</p>\n    \n    <div style=\"background: #ECFDF5; padding: 20px; border-radius: 8px; margin: 20px 0;\">\n      <p style=\"margin: 0 0 15px 0; font-weight: bold;\">Quick reflection:</p>\n      <ul style=\"margin: 0; padding-left: 20px;\">\n        <li>How are you feeling this week? (1-10)</li>\n        <li>Did you take breaks when needed?</li>\n        <li>Are you feeling connected to your team?</li>\n      </ul>\n    </div>\n    \n    <div style=\"text-align: center; margin: 30px 0;\">\n      <a href=\"{{$env.INTINC_CONNECT_URL}}/wellness/checkin\" style=\"background: #10B981; color: white; padding: 15px 30px; text-decoration: none; border-radius: 8px;\">Complete Check-in (1 min) →</a>\n    </div>\n    \n    <p><strong>Current wellness challenge:</strong> {{$json.active_challenge || 'No active challenge - join one today!'}}</p>\n    \n    <p style=\"color: #6B7280; font-size: 14px;\">💚 Your wellbeing matters to us. If you need support, reach out to HR anytime.</p>\n  </div>\n</body>\n</html>",
        "options": {}
      },
