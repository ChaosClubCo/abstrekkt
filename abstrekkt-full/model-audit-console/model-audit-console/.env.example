# Copy to .env and fill in. Never commit .env.
# All three keys are used server-side only (Node process env) - never embed
# these in frontend/client-side code if you extend this into a web console.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional overrides - defaults are set in code if omitted.
CLAUDE_AUDIT_MODEL=claude-sonnet-4-6
GPT_AUDIT_MODEL=gpt-5.5
GEMINI_AUDIT_MODEL=gemini-2.5-pro
