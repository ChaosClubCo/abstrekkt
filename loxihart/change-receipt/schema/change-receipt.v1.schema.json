{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abstrekkt.com/schemas/loxihart/change-receipt.v1.schema.json",
  "title": "Loxihart ChangeReceipt v1",
  "description": "Signed evidence about an authorized agent-authored repository change and its verification outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "verdict",
    "actor",
    "authority",
    "change",
    "verification",
    "evidence_manifest_hash",
    "issued_at",
    "signer",
    "signature",
    "failure_reasons"
  ],
  "properties": {
    "schema_version": { "const": "loxihart.change-receipt.v1" },
    "receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$"
    },
    "verdict": {
      "enum": ["VERIFIED", "REJECTED", "UNVERIFIED", "STALE"]
    },
    "actor": { "$ref": "#/$defs/actor" },
    "authority": { "$ref": "#/$defs/authority" },
    "change": { "$ref": "#/$defs/change" },
    "verification": { "$ref": "#/$defs/verification" },
    "evidence_manifest_hash": { "$ref": "#/$defs/sha256" },
    "issued_at": { "type": "string", "format": "date-time" },
    "signer": { "$ref": "#/$defs/signer" },
    "signature": {
      "type": "string",
      "pattern": "^base64url:[A-Za-z0-9_-]{43,}$"
    },
    "failure_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "verdict": { "const": "VERIFIED" } },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "failure_reasons": { "maxItems": 0 },
          "change": {
            "required": ["result_commit", "patch_hash", "tree_hash"],
            "properties": {
              "result_commit": { "$ref": "#/$defs/gitCommit" },
              "patch_hash": { "$ref": "#/$defs/sha256" },
              "tree_hash": { "$ref": "#/$defs/gitObject" }
            }
          },
          "verification": {
            "properties": {
              "tests": {
                "minItems": 1,
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/testResult" },
                    { "properties": { "exit_code": { "const": 0 } } }
                  ]
                }
              },
              "checks": {
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/checkResult" },
                    { "properties": { "status": { "const": "PASS" } } }
                  ]
                }
              },
              "read_back": {
                "allOf": [
                  { "$ref": "#/$defs/readBack" },
                  { "properties": { "status": { "const": "MATCH" } } }
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "failure_reasons": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "provider"],
      "properties": {
        "type": { "const": "agent" },
        "id": {
          "type": "string",
          "pattern": "^agent:[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "repository",
        "base_ref",
        "allowed_paths",
        "operations",
        "expires_at"
      ],
      "properties": {
        "authorization_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "base_ref": { "type": "string", "minLength": 1, "maxLength": 255 },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "not": { "pattern": "(^/|(^|/)\\.\\.(/|$)|[\\u0000-\\u001f])" }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["CREATE", "UPDATE", "DELETE", "RENAME"] }
        },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_hash", "base_commit", "result_commit", "patch_hash", "tree_hash"],
      "properties": {
        "request_hash": { "$ref": "#/$defs/sha256" },
        "base_commit": { "$ref": "#/$defs/gitCommit" },
        "result_commit": {
          "anyOf": [{ "$ref": "#/$defs/gitCommit" }, { "type": "null" }]
        },
        "patch_hash": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "tree_hash": {
          "anyOf": [{ "$ref": "#/$defs/gitObject" }, { "type": "null" }]
        }
      }
    },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command_hash", "output_hash", "exit_code", "duration_ms"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "command_hash": { "$ref": "#/$defs/sha256" },
        "output_hash": { "$ref": "#/$defs/sha256" },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "evidence_ref"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "enum": ["PASS", "FAIL", "SKIP"] },
        "evidence_ref": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "readBack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "observed_commit", "status", "observed_at"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
        "observed_commit": {
          "anyOf": [{ "$ref": "#/$defs/gitCommit" }, { "type": "null" }]
        },
        "status": { "enum": ["MATCH", "MISMATCH", "UNAVAILABLE"] },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "tests", "checks", "read_back"],
      "properties": {
        "policy_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "tests": {
          "type": "array",
          "items": { "$ref": "#/$defs/testResult" }
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/checkResult" }
        },
        "read_back": { "$ref": "#/$defs/readBack" }
      }
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        }
      }
    }
  }
}
