# Render with: python3 render-config.py
# Output: .codex/config.toml

[mcp_servers.make]
url = "https://mcp.make.com"
auth = "oauth"
enabled = true

[mcp_servers.zapier]
url = "__ZAPIER_MCP_URL__"
enabled = true

[mcp_servers.manufact]
url = "https://mcp.manufact.com/mcp"
auth = "oauth"
enabled = true

[mcp_servers.composio]
url = "https://connect.composio.dev/mcp"
enabled = true
env_http_headers = { "x-consumer-api-key" = "COMPOSIO_API_KEY" }

[mcp_servers.smithery]
url = "https://smithery.ai/docs/mcp"
enabled = true
