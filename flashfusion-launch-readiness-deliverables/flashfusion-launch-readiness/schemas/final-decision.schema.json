{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flashfusion.local/schemas/final-decision.schema.json",
  "title": "FlashFusion Final Launch Decision",
  "type": "object",
  "required": [
    "schema_version",
    "system",
    "release",
    "decision",
    "domain_results",
    "hard_gates",
    "blockers",
    "conditions",
    "contradictions",
    "launch_monitoring",
    "claims_check"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "system": {
      "const": "flashfusion-launch-readiness"
    },
    "release": {
      "type": "object"
    },
    "decision": {
      "type": "object",
      "required": [
        "verdict",
        "weighted_score",
        "adjusted_score",
        "weighted_confidence",
        "minimum_go_score",
        "summary"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "GO",
            "CONDITIONAL_GO",
            "NO_GO",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "weighted_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "adjusted_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "weighted_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "minimum_go_score": {
          "type": "number"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "domain_results": {
      "type": "array"
    },
    "hard_gates": {
      "type": "array"
    },
    "blockers": {
      "type": "array"
    },
    "conditions": {
      "type": "array"
    },
    "contradictions": {
      "type": "array"
    },
    "launch_monitoring": {
      "type": "object"
    },
    "claims_check": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
