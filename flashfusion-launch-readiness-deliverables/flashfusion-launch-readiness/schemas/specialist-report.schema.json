{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flashfusion.local/schemas/specialist-report.schema.json",
  "title": "FlashFusion Specialist Readiness Report",
  "type": "object",
  "required": [
    "schema_version",
    "agent",
    "release",
    "assessment",
    "subscores",
    "findings",
    "verified_controls",
    "unknowns",
    "dependencies",
    "required_actions",
    "claims_check"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "agent": {
      "type": "object",
      "required": [
        "id",
        "name",
        "domain",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "domain": {
          "enum": [
            "UX",
            "SECURITY",
            "GROWTH",
            "AI",
            "INFRASTRUCTURE"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": [
        "name",
        "version",
        "commit_sha",
        "environment",
        "evaluated_at"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "commit_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment": {
          "type": "string"
        },
        "evaluated_at": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "assessment": {
      "type": "object",
      "required": [
        "score",
        "maximum_score",
        "confidence",
        "verdict",
        "summary"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "maximum_score": {
          "const": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "verdict": {
          "enum": [
            "PASS",
            "CONDITIONAL_PASS",
            "FAIL",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "subscores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "weight",
          "score",
          "confidence",
          "notes"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "severity",
          "status",
          "evidence_level",
          "description",
          "affected_components",
          "user_or_business_impact",
          "probability",
          "exposure",
          "detectability",
          "priority_score",
          "evidence",
          "recommended_action",
          "acceptance_criteria",
          "owner_role",
          "estimated_effort",
          "blocks_launch"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFORMATIONAL"
            ]
          },
          "status": {
            "enum": [
              "OPEN",
              "MITIGATED",
              "ACCEPTED_RISK",
              "RESOLVED",
              "NOT_APPLICABLE",
              "UNVERIFIED"
            ]
          },
          "evidence_level": {
            "enum": [
              "VERIFIED",
              "SUPPORTED",
              "INFERRED",
              "UNKNOWN"
            ]
          },
          "description": {
            "type": "string"
          },
          "affected_components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "user_or_business_impact": {
            "type": "string"
          },
          "probability": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "exposure": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "detectability": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "priority_score": {
            "type": "number",
            "minimum": 0
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "reference",
                "details"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "reference": {
                  "type": "string"
                },
                "details": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "recommended_action": {
            "type": "string"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner_role": {
            "type": "string"
          },
          "estimated_effort": {
            "enum": [
              "XS",
              "S",
              "M",
              "L",
              "XL"
            ]
          },
          "blocks_launch": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "verified_controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "control",
          "verified",
          "evidence"
        ],
        "properties": {
          "control": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "unknowns": {
      "type": "array"
    },
    "dependencies": {
      "type": "array"
    },
    "required_actions": {
      "type": "array"
    },
    "claims_check": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
